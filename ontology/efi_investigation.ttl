# ============================================================================
#  EFI-Onto : 조사 기록 층 (T01~T16)
#  출처가 있는 현장 기록의 어휘와 완비 검사. efi_tbox.ttl 과 한 그래프를 이룬다.
#
#  **이 파일의 자원은 점수·반증·형성·결론에 닿지 않는다.** 기록이 갖춰졌는지만
#  본다. 완비는 원인 판정이 아니다 — 연결이 확인돼도 통전이 아니고, 토크 기록이
#  있어도 체결 상태가 유지됐다는 뜻이 아니다. 판정에 닿는 도형은 efi_tbox.ttl 에
#  둔다(결론 제약 ConclusionFirstFuelEvidenceShape·ConclusionHeatTransferEvidenceShape).
#  경계는 tests/test_ontology.py 의 test_investigation_layer_never_touches_scoring 이 지킨다.
# ============================================================================

@prefix efi:     <https://w3id.org/efi-onto#> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix ssn:     <http://www.w3.org/ns/ssn/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================================
# 50. 조사 계통과 출처가 있는 연결 기록 (T01)
#     구조적 연결은 통전·발화 원인의 증명이 아니다. 모델별 부품 식별자를 사용한다.
# ============================================================================
efi:InvestigationRecord a owl:Class ; rdfs:subClassOf efi:Observation ; rdfs:label "출처가 있는 조사 기록"@ko ; skos:prefLabel "출처가 있는 조사 기록"@ko .
efi:ElectricalSystemModel a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "관심 영역의 전기 계통 모델"@ko ; skos:prefLabel "관심 영역의 전기 계통 모델"@ko .
efi:ConnectionRecord a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "계통 연결 관찰 기록"@ko ; skos:prefLabel "계통 연결 관찰 기록"@ko .
efi:SupplyPathAssessment a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "전원별 공급 경로 검토"@ko ; skos:prefLabel "전원별 공급 경로 검토"@ko .
efi:PowerSource a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "전력 공급원"@ko ; skos:prefLabel "전력 공급원"@ko .
efi:ElectricalLoad a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "전기 부하"@ko ; skos:prefLabel "전기 부하"@ko .
efi:ElectricalSwitch a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "전기 개폐기"@ko ; skos:prefLabel "전기 개폐기"@ko .
efi:Conduit a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "전선관"@ko ; skos:prefLabel "전선관"@ko .
efi:GroundedSurface a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "접지된 금속면"@ko ; skos:prefLabel "접지된 금속면"@ko .
efi:hasSystemModel a owl:ObjectProperty ; rdfs:range efi:ElectricalSystemModel ; skos:prefLabel "검토한 계통 모델"@ko .
efi:hasInvestigationRecord a owl:ObjectProperty ; rdfs:range efi:InvestigationRecord ; skos:prefLabel "조사 기록"@ko .
efi:recordSession a owl:ObjectProperty ; rdfs:range efi:InvestigationSession ; skos:prefLabel "기록의 세션"@ko .
efi:systemComponent a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "계통 구성요소"@ko .
efi:componentModel a owl:ObjectProperty ; rdfs:range efi:ElectricalSystemModel ; skos:prefLabel "구성요소의 계통 모델"@ko .
efi:componentContainer a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "설치 함체·기구"@ko .
efi:componentCircuit a owl:ObjectProperty ; rdfs:range efi:Circuit ; skos:prefLabel "구성요소의 회로"@ko .
efi:recordSystem a owl:ObjectProperty ; rdfs:range efi:ElectricalSystemModel ; skos:prefLabel "기록 대상 계통"@ko .
efi:connectionFrom a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "연결 시작 구성요소"@ko .
efi:connectionTo a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "연결 끝 구성요소"@ko .
efi:confirmedFeeds a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "확인된 구조적 공급 연결"@ko .
efi:assessedSource a owl:ObjectProperty ; rdfs:range efi:PowerSource ; skos:prefLabel "검토 대상 공급원"@ko .
efi:assessedLoad a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "검토 대상 부하·구성요소"@ko .
efi:recordSource a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "원자료 식별·위치"@ko .
efi:recordObservedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "기록 관찰 시각"@ko .
efi:componentRole a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "도체·단자의 전기적 역할"@ko .
efi:connectionKind a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "연결의 기능"@ko .
efi:systemReviewComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean ; skos:prefLabel "공급 경로 검토 완료 주장"@ko .
efi:sourceInventoryComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean ; skos:prefLabel "관련 공급원 식별 완료 확인"@ko .
efi:pathConnected a owl:DatatypeProperty ; rdfs:range xsd:boolean ; skos:prefLabel "확인 연결로 도달함"@ko .

efi:InvestigationRecordShape a sh:NodeShape ; sh:targetClass efi:InvestigationRecord ; sh:targetObjectsOf efi:hasInvestigationRecord ;
    dcterms:references "NFPA 921 (2024) §4.3.3; §9.12" ;
    sh:property [ sh:path efi:confirmationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( efi:Confirmed efi:ConfirmedAbsent efi:Unverifiable efi:Missing ) ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path efi:recordSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] ;
    sh:property [ sh:path efi:recordObservedAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path efi:recordSession ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:InvestigationSession ] .

efi:SystemComponentShape a sh:NodeShape ; sh:targetObjectsOf efi:systemComponent ;
    dcterms:references "NFPA 921 (2024) §9.7; §9.8; §9.12.4" ;
    sh:property [ sh:path efi:componentModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalSystemModel ] ;
    sh:property [ sh:path efi:componentContainer ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:componentCircuit ; sh:class efi:Circuit ] ;
    sh:property [ sh:path efi:componentRole ; sh:maxCount 1 ; sh:in ( "Ungrounded" "Neutral" "Grounding" "Unknown" ) ] .

efi:ConnectionRecordShape a sh:NodeShape ; sh:targetClass efi:ConnectionRecord ;
    dcterms:references "NFPA 921 (2024) §9.4; §9.7; §9.8; §9.12.4" ;
    sh:property [ sh:path efi:connectionFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:connectionTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:recordSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalSystemModel ] ;
    sh:property [ sh:path efi:connectionKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Supply" "Grounding" "SwitchControl" "Protection" ) ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "연결 대상은 같은 세션·계통에 속해야 한다"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:recordSystem ?sys ; efi:recordSession ?s ; efi:connectionFrom ?a ; efi:connectionTo ?b .
          FILTER (?a = ?b || NOT EXISTS { ?sys efi:recordSession ?s ; efi:systemComponent ?a, ?b . ?a efi:componentModel ?sys . ?b efi:componentModel ?sys . })
        }""" ] .

efi:ConfirmedConnectionRuleShape a sh:NodeShape ; sh:targetClass efi:ConnectionRecord ;
    dcterms:references "NFPA 921 (2024) §9.7; §9.8; §9.12.4" ;
    sh:order -3 ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order -3 ;
        sh:construct """
        CONSTRUCT { ?a efi:confirmedFeeds ?b . }
        WHERE {
          $this efi:connectionFrom ?a ; efi:connectionTo ?b ; efi:connectionKind "Supply" ;
            efi:recordSystem ?sys ; efi:recordSession ?s ; efi:confirmationStatus efi:Confirmed ;
            prov:wasAttributedTo ?who ; efi:recordSource ?src .
          ?sys efi:recordSession ?s ; efi:systemComponent ?a, ?b .
          ?a efi:componentModel ?sys . ?b efi:componentModel ?sys .
          FILTER (STRLEN(STR(?src)) > 0)
        }""" ] .

efi:SupplyPathAssessmentShape a sh:NodeShape ; sh:targetClass efi:SupplyPathAssessment ;
    dcterms:references "NFPA 921 (2024) §9.12.4" ;
    sh:order -2 ;
    sh:property [ sh:path efi:assessedSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:PowerSource ] ;
    sh:property [ sh:path efi:assessedLoad ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:recordSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalSystemModel ] ;
    sh:property [ sh:path efi:pathConnected ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order -2 ;
        sh:construct """
        CONSTRUCT { $this efi:pathConnected true . }
        WHERE {
          $this efi:assessedSource ?source ; efi:assessedLoad ?load ; efi:recordSystem ?sys ; efi:recordSession ?s ;
            efi:confirmationStatus efi:Confirmed ; prov:wasAttributedTo ?who ; efi:recordSource ?src .
          ?sys efi:recordSession ?s ; efi:systemComponent ?source, ?load .
          ?source efi:confirmedFeeds+ ?load .
          FILTER (STRLEN(STR(?src)) > 0)
        }""" ] .

efi:SystemReviewCoverageShape a sh:NodeShape ; sh:targetClass efi:ElectricalSystemModel ;
    dcterms:references "NFPA 921 (2024) §9.12.1; §9.12.4" ;
    sh:property [ sh:path efi:systemReviewComplete ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path efi:sourceInventoryComplete ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "공급원 식별과 전원별 요구 경로를 확인하기 전에는 계통 검토를 완료로 표시할 수 없다 (§9.12.4)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:systemReviewComplete true .
          FILTER (NOT EXISTS { $this efi:sourceInventoryComplete true ; efi:confirmationStatus efi:Confirmed }
            || NOT EXISTS { ?p a efi:SupplyPathAssessment ; efi:recordSystem $this }
            || EXISTS { $this efi:systemComponent ?source . ?source a efi:PowerSource .
                 FILTER NOT EXISTS { ?p a efi:SupplyPathAssessment ; efi:recordSystem $this ; efi:assessedSource ?source } }
            || EXISTS { ?p a efi:SupplyPathAssessment ; efi:recordSystem $this .
                 FILTER NOT EXISTS { ?p efi:confirmationStatus efi:Confirmed ; efi:pathConnected true } })
        }""" ] .

# 51. 보호장치 발견 상태와 동작·취급 사건을 분리한다 (T02).
efi:DeviceStateRecord a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "보호장치 발견 상태 기록"@ko ; skos:prefLabel "보호장치 발견 상태 기록"@ko .
efi:ElectricalEventRecord a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "전기 계통 사건 기록"@ko ; skos:prefLabel "전기 계통 사건 기록"@ko .
efi:recordComponent a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "기록 대상 구성요소"@ko .
efi:eventSupplySource a owl:ObjectProperty ; rdfs:range efi:PowerSource ; skos:prefLabel "사건의 공급원"@ko .
efi:replacementComponent a owl:ObjectProperty ; rdfs:range efi:ElectricalArtifact ; skos:prefLabel "교체된 새 구성요소"@ko .
efi:deviceFoundState a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "발견 시 보호장치 위치·상태"@ko .
efi:electricalEventKind a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "계통 사건 종류"@ko .
efi:replacementCompatibility a owl:DatatypeProperty ; rdfs:range xsd:boolean ; skos:prefLabel "교체품 적합성 확인값"@ko .

efi:DeviceStateRecordShape a sh:NodeShape ; sh:targetClass efi:DeviceStateRecord ;
    dcterms:references "NFPA 921 (2024) §9.8.2.1; §9.12.6.2; §9.13.2.2" ;
    sh:property [ sh:path efi:recordComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ProtectiveDevice ] ;
    sh:property [ sh:path efi:deviceFoundState ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "On" "Off" "Tripped" "FuseOpen" "Unknown" ) ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "장치 상태 기록의 대상은 같은 세션의 계통에 속해야 한다"@ko ;
        sh:select """SELECT $this WHERE { $this efi:recordSession ?s ; efi:recordComponent ?c .
          FILTER NOT EXISTS { ?s efi:hasSystemModel/efi:systemComponent ?c } }""" ] .

efi:ElectricalEventRecordShape a sh:NodeShape ; sh:targetClass efi:ElectricalEventRecord ;
    dcterms:references "NFPA 921 (2024) §9.12.5.3; §9.12.6.2; §9.12.7.2" ;
    sh:property [ sh:path efi:recordComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:eventSupplySource ; sh:maxCount 1 ; sh:class efi:PowerSource ] ;
    sh:property [ sh:path efi:replacementComponent ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:replacementCompatibility ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path efi:electricalEventKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "PowerDisconnected" "PowerRestored" "AutomaticTrip" "ManualSwitchOff" "ManualSwitchOn" "ManualReset" "Replacement" "Removal" "Modification" "Disassembly" "Bending" "TensionHandling" "Sampling" "ArcOccurrence" "FireArrival" "Ignition" "ContactArcOccurrence" "InsulationBreakdown" "MetalDeposition" ) ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ; sh:message "사건·상태 기록의 대상은 같은 세션에서 조사한 계통 구성요소여야 한다"@ko ; sh:select """
      SELECT $this WHERE {
        $this efi:recordSession ?s ; efi:recordComponent ?c .
        FILTER NOT EXISTS { ?s efi:hasSystemModel/efi:systemComponent ?c }
      }""" ] .

# 52. 사건 시간 범위·공급원별 이력·AMI 수집 범위 (T03).
# 시간 구간이 겹치거나 복전 이력이 불완전하면 단정하지 않는다.
efi:PowerRecordCoverage a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "전력 기록의 수집·시간 범위"@ko ; skos:prefLabel "전력 기록의 수집·시간 범위"@ko .
efi:describesElectricalEvent a owl:ObjectProperty ; rdfs:range time:TemporalEntity ; skos:prefLabel "기록이 기술하는 실제 사건"@ko .
efi:recordPrecedes a owl:ObjectProperty ; rdfs:range efi:ElectricalEventRecord ; skos:prefLabel "확인 시간 범위가 앞서는 기록"@ko .
efi:eventEarliest a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "사건의 가장 이른 가능 시각"@ko .
efi:eventLatest a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "사건의 가장 늦은 가능 시각"@ko .
efi:coverageStart a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "전력 기록 범위 시작"@ko .
efi:coverageEnd a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "전력 기록 범위 끝"@ko .
efi:recordAvailability a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "전력 기록 확보 상태"@ko .
efi:collectedEventKind a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "수집된 전력 기록 종류"@ko .
efi:powerHistoryComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean ; skos:prefLabel "해당 범위의 복전 이력 완전성 확인"@ko .

efi:EventTimeRangeShape a sh:NodeShape ; sh:targetClass efi:ElectricalEventRecord ;
    dcterms:references "NFPA 921 (2024) §9.12.5.3; §19.4.4.2; §19.6.4.5" ;
    sh:property [ sh:path efi:eventEarliest ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ; sh:lessThanOrEquals efi:eventLatest ] ;
    sh:property [ sh:path efi:eventLatest ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    sh:property [ sh:path efi:describesElectricalEvent ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ; sh:message "사건 선후 기록이 순환하거나 같은 세션의 시간 범위와 모순된다"@ko ; sh:select """
      SELECT $this WHERE {
        { $this efi:recordPrecedes+ $this }
        UNION { $this efi:recordPrecedes ?other ; efi:recordSession ?s .
          FILTER NOT EXISTS { ?other efi:recordSession ?s } }
        UNION { $this efi:recordPrecedes ?other ; efi:eventEarliest ?a .
          ?other efi:eventLatest ?b . FILTER (?a >= ?b) }
      }""" ] .

efi:PowerRecordCoverageShape a sh:NodeShape ; sh:targetClass efi:PowerRecordCoverage ;
    dcterms:references "NFPA 921 (2024) §9.12.5.5.1" ;
    sh:property [ sh:path efi:eventSupplySource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:PowerSource ] ;
    sh:property [ sh:path efi:coverageStart ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ; sh:lessThanOrEquals efi:coverageEnd ] ;
    sh:property [ sh:path efi:coverageEnd ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    sh:property [ sh:path efi:recordAvailability ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Available" "Unavailable" "Unknown" ) ] ;
    sh:property [ sh:path efi:collectedEventKind ; sh:in ( "PowerDisconnected" "PowerRestored" "Usage" ) ] ;
    sh:property [ sh:path efi:powerHistoryComplete ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ; sh:message "복전 이력 완전성을 주장하려면 실제 기록·수집 종류·시간 범위가 확인되어야 한다"@ko ; sh:select """
      SELECT $this WHERE {
        $this efi:powerHistoryComplete true .
        FILTER NOT EXISTS { $this efi:recordAvailability "Available" ; efi:confirmationStatus efi:Confirmed ;
          efi:collectedEventKind "PowerRestored" ; efi:coverageStart ?a ; efi:coverageEnd ?b . FILTER (?a <= ?b) }
      }""" ] .

efi:EventTimeOrderRuleShape a sh:NodeShape ; sh:targetClass efi:ElectricalEventRecord ;
    dcterms:references "NFPA 921 (2024) §9.12.5.3; §19.4.4.2" ;
    sh:order -2 ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order -2 ; sh:construct """
      CONSTRUCT { $this efi:recordPrecedes ?other . }
      WHERE {
        $this efi:recordSession ?s ; efi:eventEarliest ?start ; efi:eventLatest ?end ;
          efi:confirmationStatus efi:Confirmed ; prov:wasAttributedTo ?who ; efi:recordSource ?src .
        ?other a efi:ElectricalEventRecord ; efi:recordSession ?s ; efi:eventEarliest ?start2 ; efi:eventLatest ?end2 ;
          efi:confirmationStatus efi:Confirmed ; prov:wasAttributedTo ?who2 ; efi:recordSource ?src2 .
        FILTER (?start <= ?end && ?start2 <= ?end2 && ?end < ?start2 && STRLEN(STR(?src)) > 0 && STRLEN(STR(?src2)) > 0)
      }""" ] .

efi:LocalArcFireSequenceRuleShape a sh:NodeShape ; sh:targetClass efi:ElectricalEventRecord ;
    dcterms:references "NFPA 921 (2024) §9.10.1; §9.12.5.3; §19.4.4.2" ;
    sh:order -1 ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order -1 ; sh:construct """
      CONSTRUCT { ?event time:before ?event2 . }
      WHERE {
        $this efi:recordPrecedes ?other ; efi:recordComponent ?component ; efi:recordSession ?s ;
          efi:electricalEventKind ?kind ; efi:describesElectricalEvent ?event ; efi:confirmationStatus efi:Confirmed ;
          efi:eventLatest ?end .
        ?other efi:recordComponent ?component ; efi:recordSession ?s ; efi:electricalEventKind ?kind2 ;
          efi:describesElectricalEvent ?event2 ; efi:confirmationStatus efi:Confirmed ; efi:eventEarliest ?start .
        FILTER (?end < ?start && ((?kind IN ("ArcOccurrence", "ContactArcOccurrence") && ?kind2 = "FireArrival") || (?kind = "FireArrival" && ?kind2 IN ("ArcOccurrence", "ContactArcOccurrence"))))
      }""" ] .

efi:SupplyTimelineConflictShape a sh:NodeShape ; sh:targetClass efi:ElectricalEventRecord ;
    dcterms:references "NFPA 921 (2024) §9.12.5.3; §9.12.5.5.1; §19.6.4.5" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ; sh:message "동일 공급원의 차단·복전 기록과 아크 시간이 충돌한다. 다른 공급원·기록 누락·시각 근거를 재검토한다"@ko ; sh:select """
      SELECT $this WHERE {
        $this efi:electricalEventKind ?arcKind ; efi:recordSession ?s ; efi:eventSupplySource ?source ;
          efi:confirmationStatus efi:Confirmed ; efi:eventEarliest ?arcMin ; efi:eventLatest ?arcMax .
        FILTER (?arcKind IN ("ArcOccurrence", "ContactArcOccurrence"))
        ?cut a efi:ElectricalEventRecord ; efi:recordSession ?s ; efi:eventSupplySource ?source ;
          efi:electricalEventKind "PowerDisconnected" ; efi:confirmationStatus efi:Confirmed ;
          efi:eventEarliest ?cutMin ; efi:eventLatest ?cutMax .
        ?coverage a efi:PowerRecordCoverage ; efi:recordSession ?s ; efi:eventSupplySource ?source ;
          efi:confirmationStatus efi:Confirmed ; efi:recordAvailability "Available" ;
          efi:powerHistoryComplete true ; efi:collectedEventKind "PowerRestored" ;
          efi:coverageStart ?from ; efi:coverageEnd ?to .
        FILTER (?cutMin <= ?cutMax && ?arcMin <= ?arcMax && ?cutMax < ?arcMin && ?from <= ?cutMin && ?to >= ?arcMax)
        FILTER NOT EXISTS {
          ?restore a efi:ElectricalEventRecord ; efi:recordSession ?s ; efi:eventSupplySource ?source ;
            efi:electricalEventKind "PowerRestored" ; efi:confirmationStatus ?status .
          FILTER (?status != efi:ConfirmedAbsent)
          OPTIONAL { ?restore efi:eventEarliest ?rMin }
          OPTIONAL { ?restore efi:eventLatest ?rMax }
          FILTER (!BOUND(?rMin) || !BOUND(?rMax) || (?rMax >= ?cutMin && ?rMin <= ?arcMax))
        }
      }""" ] .

# 53. 최초 착화물·열전달 검토의 근거 (T04). 후보에는 결측을 허용한다.
efi:FirstFuelAssessment a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "발화 당시 최초 착화물 존재 검토"@ko ; skos:prefLabel "발화 당시 최초 착화물 존재 검토"@ko .
efi:HeatTransferAssessment a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "발열원에서 연료까지의 열전달 검토"@ko ; skos:prefLabel "발열원에서 연료까지의 열전달 검토"@ko .
efi:assessedScenario a owl:ObjectProperty ; rdfs:range efi:IgnitionScenario ; skos:prefLabel "검토 대상 발화 가설"@ko .
efi:assessedFuel a owl:ObjectProperty ; rdfs:range efi:FirstFuelIgnited ; skos:prefLabel "검토 대상 최초 착화물"@ko .
efi:assessedMechanism a owl:ObjectProperty ; rdfs:range efi:HeatingMechanism ; skos:prefLabel "검토 대상 발열 메커니즘"@ko .
efi:fuelPresenceBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "발화 당시 연료 존재의 근거"@ko .
efi:transferDescription a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "발열원과 연료 사이의 열전달 설명"@ko .
efi:heatAdequacyBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "착화에 필요한 열 충분성 근거"@ko .
efi:durationBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "가열 지속 시간의 근거·한계"@ko .
efi:fuelConditionBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "연료 배치·형상·상태의 근거"@ko .

efi:FirstFuelAssessmentShape a sh:NodeShape ; sh:targetClass efi:FirstFuelAssessment ;
    dcterms:references "NFPA 921 (2024) §9.9.1; §19.5.3" ;
    sh:property [ sh:path efi:assessedScenario ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:IgnitionScenario ] ;
    sh:property [ sh:path efi:assessedFuel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:FirstFuelIgnited ] ;
    sh:property [ sh:path efi:fuelPresenceBasis ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] .

efi:HeatTransferAssessmentShape a sh:NodeShape ; sh:targetClass efi:HeatTransferAssessment ;
    dcterms:references "NFPA 921 (2024) §9.9.1.1; §9.9.1.2; §9.9.1.3; §9.9.1.4" ;
    sh:property [ sh:path efi:assessedScenario ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:IgnitionScenario ] ;
    sh:property [ sh:path efi:assessedFuel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:FirstFuelIgnited ] ;
    sh:property [ sh:path efi:assessedMechanism ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:HeatingMechanism ] ;
    sh:property [ sh:path efi:transferDescription ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] ;
    sh:property [ sh:path efi:heatAdequacyBasis ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] ;
    sh:property [ sh:path efi:durationBasis ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] ;
    sh:property [ sh:path efi:fuelConditionBasis ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\S" ] .

# T01: 계통 구성요소별 검사·손상 범위. 아크 미발견은 아크 사건 부재가 아니다.
efi:ComponentExamination a owl:Class ; rdfs:subClassOf efi:InvestigationRecord ; rdfs:label "계통 구성요소 검사 기록"@ko ; skos:prefLabel "계통 구성요소 검사 기록"@ko .
efi:ElectricMeter a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "전력 계량기"@ko ; skos:prefLabel "전력 계량기"@ko .
efi:componentDamageState a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "구성요소에서 관찰한 손상 상태"@ko .
efi:observedInsulationMaterial a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "관찰한 절연 재질"@ko .
efi:observedArcSiteStatus a owl:ObjectProperty ; rdfs:range efi:ConfirmationStatus ; skos:prefLabel "구성요소 아크 지점의 관찰 상태"@ko .

efi:ComponentExaminationShape a sh:NodeShape ; sh:targetClass efi:ComponentExamination ;
    dcterms:references "NFPA 921 (2024) §9.6.4.3; §9.12.1; §9.13.3.1; §9.13.4.5" ;
    sh:property [ sh:path efi:recordComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class efi:ElectricalArtifact ] ;
    sh:property [ sh:path efi:componentDamageState ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Damaged" "NoDamageObserved" "NotAccessible" "Unknown" ) ] ;
    sh:property [ sh:path efi:observedArcSiteStatus ; sh:maxCount 1 ; sh:in ( efi:Confirmed efi:ConfirmedAbsent efi:Unverifiable efi:Missing ) ] ;
    sh:property [ sh:path efi:observedInsulationMaterial ; sh:maxCount 1 ; sh:in ( "Rubber" "PVC" "Polyethylene" "Other" "Unknown" ) ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ; sh:message "검사 대상 구성요소는 같은 세션의 계통에 속해야 한다"@ko ; sh:select """
      SELECT $this WHERE { $this efi:recordSession ?s ; efi:recordComponent ?c .
        FILTER NOT EXISTS { ?s efi:hasSystemModel/efi:systemComponent ?c } }
    """ ] .

