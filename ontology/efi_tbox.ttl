# ============================================================================
#  [부가 모듈 B] 형태학적 중첩 (morphological overlap)
#  ---------------------------------------------------------------------------
#  근거: 논문 4.2절 — 오분류는 무작위가 아니라 '비시각적 변별 축을 공유하는
#        가설 쌍'에 구조적으로 집중된다 (절연열화↔압착손상 64회, 트래킹↔접촉불량 66회).
#  모델링 원칙:
#   - canManifest 는 '이 가설이 남길 수 있는 손상 양상'의 가능 집합이며,
#     정의 조건(hasMechanism)이나 단서 규칙(IndicatorRule)과 층위가 다르다.
#   - 두 가설의 canManifest 교집합이 곧 사진만으로는 갈리지 않는 지대다.
#   - 따라서 변별력은 손상 양상 자체의 성질(sharedByCount)로 계산된다.
# ============================================================================
efi:canManifest a owl:ObjectProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:DamagePattern ;
    rdfs:label "형태학적으로 나타날 수 있음"@ko ;
    rdfs:comment "해당 가설이 남길 수 있는 손상 양상. 가능 집합이며 충분조건이 아니다."@ko .

efi:morphologicallyAmbiguousWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:IgnitionScenario ;
    rdfs:label "형태학적으로 혼동될 수 있음"@ko ;
    rdfs:comment "손상 양상을 2개 이상 공유하는 가설 쌍. 사진 단독으로는 확정할 수 없다."@ko .

efi:sharedMorphologyCount a owl:DatatypeProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:integer ;
    rdfs:label "공유 손상 양상 수"@ko .

efi:sharedByScenarioCount a owl:DatatypeProperty ;
    rdfs:domain efi:DamagePattern ; rdfs:range xsd:integer ;
    rdfs:label "이 양상을 남길 수 있는 가설 수"@ko .

efi:isDiscriminatingMorphology a owl:DatatypeProperty ;
    rdfs:domain efi:DamagePattern ; rdfs:range xsd:boolean ;
    rdfs:label "단독 변별 가능 양상"@ko ;
    rdfs:comment "한 가설에서만 나타나는 손상 양상. 사진만으로 가설을 좁힐 수 있다."@ko .

efi:PoorContactScenario efi:canManifest efi:LocalizedDiscoloration , efi:CuprousOxideGrowth , efi:LossOfLuster , efi:LongTermTerminalHeating , efi:InsulationCarbonization .
efi:CrushDamageScenario efi:canManifest efi:MechanicalDeformation , efi:WholeConductorCrushedOrCut , efi:LargeMeltMark , efi:ArcMeltMark , efi:ArcBead , efi:InsulationCarbonization , efi:Spatter .
efi:PartialDisconnectionScenario efi:canManifest efi:StrandFracture , efi:StrandFractureAtStressPoint , efi:SmallMeltBallOnStrandEnd , efi:MultipleArcBeads , efi:ArcBead , efi:InsulationCarbonization .
efi:InsulationDegradationScenario efi:canManifest efi:InsulationEmbrittlement , efi:InsulationCarbonization , efi:ArcMeltMark , efi:ArcBead , efi:LocalizedDiscoloration .
efi:TrackingScenario efi:canManifest efi:CarbonizedConductivePath , efi:InsulationCarbonization , efi:LocalizedDiscoloration , efi:BurnCenterOnSurface , efi:ArcBead .
efi:ExternalFlameScenario efi:canManifest efi:GeneralMelting , efi:Sagging , efi:ThermalGradientFlow , efi:FireMeltMark , efi:SecondaryArcMark , efi:LargeMeltMark , efi:InsulationCarbonization .

# [M-1] 손상 양상별 변별력 산출 — 몇 개 가설이 이 양상을 남길 수 있는가
efi:MorphologyDiscriminationRuleShape a sh:NodeShape ; sh:targetObjectsOf efi:canManifest ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:sharedByScenarioCount ?n . $this efi:isDiscriminatingMorphology ?d . }
        WHERE {
          { SELECT $this (COUNT(DISTINCT ?s) AS ?n) WHERE { ?s efi:canManifest $this . } GROUP BY $this }
          FILTER(?n > 0)
          BIND( IF(?n = 1, true, false) AS ?d )
        }""" ] .

# [M-2] 형태학적 혼동 쌍 도출 — 손상 양상을 2개 이상 공유하면 사진 단독 확정 불가
efi:MorphologicalAmbiguityRuleShape a sh:NodeShape ; sh:targetSubjectsOf efi:canManifest ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:morphologicallyAmbiguousWith ?o . }
        WHERE {
          { SELECT $this ?o (COUNT(DISTINCT ?d) AS ?n) WHERE {
              $this efi:canManifest ?d . ?o efi:canManifest ?d . FILTER($this != ?o) }
            GROUP BY $this ?o }
          FILTER(?n >= 2)
        }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 1 ;
        sh:construct """
        CONSTRUCT { $this efi:sharedMorphologyCount ?n . }
        WHERE {
          { SELECT $this (COUNT(DISTINCT ?d) AS ?n) WHERE {
              $this efi:canManifest ?d . ?o efi:canManifest ?d . FILTER($this != ?o) }
            GROUP BY $this }
        }""" ] .

# [C-5] 공유 형태만으로는 확정할 수 없다 (논문 4.2절의 구조적 혼동을 제약으로 고정)
#  결론이 서는 근거 중 최소 1건은 (a) 그 가설에서만 나타나는 손상 양상이거나
#  (b) 손상 양상이 아닌 현장 사실·선행 조건·계측값이어야 한다.
#  즉 피복 탄화·아크 비드처럼 여러 가설에 공통으로 나타나는 양상만 모아서는 확정되지 않는다.
efi:MorphologyOnlyConclusionShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "공유 형태학적 단서만으로는 확정할 수 없다. 해당 가설에만 나타나는 양상 또는 비시각적 현장 사실이 최소 1건 필요하다 (논문 4.2절)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          FILTER NOT EXISTS {
            ?sc efi:supportedBy ?f .
            ?f efi:confirmationStatus efi:Confirmed .
            ?f rdf:type ?C .
            FILTER( EXISTS { ?C efi:isDiscriminatingMorphology true }
                 || NOT EXISTS { ?C rdfs:subClassOf* efi:DamagePattern } )
          }
        }""" ] .

# ============================================================================
#  [부가 모듈 C] 축 간 인과 연결
#  ---------------------------------------------------------------------------
#  선행조건 --enables--> 발열메커니즘 --producesDamage--> 손상양상
#                              └--ignites--> 착화물
#  물리증거물 --exhibits--> 손상양상      현장사실 --attests--> 선행조건
#
#  네 축을 분리한 이유는 섞이지 않게 하기 위해서지, 끊어 두기 위해서가 아니다.
#  분리한 축은 명시적 관계로만 이어지며, 그 경로가 곧 감식 논리의 추적 경로가 된다.
# ============================================================================
efi:attests a owl:ObjectProperty ;
    rdfs:domain efi:SceneEvidence ; rdfs:range efi:AntecedentCondition ;
    rdfs:label "선행 조건을 증언함"@ko ;
    rdfs:comment "현장에서 확인된 사실이 어떤 선행 조건의 존재를 뒷받침하는가."@ko .

# 선행 조건 → 발열 메커니즘
efi:LooseConnection efi:enables efi:PoorContactHeating , efi:GlowingConnection .
efi:CorrodedConnection efi:enables efi:PoorContactHeating , efi:GlowingConnection .
efi:AgedInsulation efi:enables efi:InsulationBreakdownArc , efi:LeakageCurrentHeating .
efi:ReducedInsulationResistance efi:enables efi:InsulationBreakdownArc , efi:LeakageCurrentHeating , efi:ArcTracking .
efi:ThermalDegradation efi:enables efi:InsulationBreakdownArc .
efi:InsulationDeterioration efi:enables efi:InsulationBreakdownArc , efi:LeakageCurrentHeating .
efi:RepeatedFlexing efi:enables efi:PartialDisconnectionHeating , efi:SeriesArc .
efi:Vibration efi:enables efi:PartialDisconnectionHeating , efi:SeriesArc , efi:PoorContactHeating .
efi:Tension efi:enables efi:PartialDisconnectionHeating .
efi:LongTermRepeatedStress efi:enables efi:PartialDisconnectionHeating .
efi:ExternalCrushing efi:enables efi:CrushInducedArc , efi:ShortCircuitArc .
efi:AbrasionAtPenetration efi:enables efi:CrushInducedArc , efi:ShortCircuitArc .
efi:ContaminatedEnvironment efi:enables efi:ArcTracking , efi:LeakageCurrentHeating .
efi:MoistureExposure efi:enables efi:ArcTracking , efi:LeakageCurrentHeating .
efi:DustAccumulation efi:enables efi:ArcTracking .
efi:SalineOrChemicalExposure efi:enables efi:ArcTracking , efi:LeakageCurrentHeating .
efi:OverloadState efi:enables efi:OverloadHeating , efi:ResistiveHeating .
efi:EnergizedState efi:enables efi:ResistiveHeating , efi:ArcHeating .

# 발열 메커니즘 → 손상 양상
efi:PoorContactHeating efi:producesDamage efi:LocalizedDiscoloration , efi:CuprousOxideGrowth , efi:LossOfLuster , efi:LongTermTerminalHeating , efi:InsulationCarbonization .
efi:GlowingConnection efi:producesDamage efi:CuprousOxideGrowth , efi:LocalizedDiscoloration , efi:InsulationCarbonization .
efi:OverloadHeating efi:producesDamage efi:InsulationCarbonization , efi:LocalizedDiscoloration .
efi:ResistiveHeating efi:producesDamage efi:LocalizedDiscoloration , efi:InsulationCarbonization .
efi:PartialDisconnectionHeating efi:producesDamage efi:StrandFracture , efi:StrandFractureAtStressPoint , efi:SmallMeltBallOnStrandEnd , efi:InsulationCarbonization .
efi:SeriesArc efi:producesDamage efi:ArcBead , efi:MultipleArcBeads , efi:SmallMeltBallOnStrandEnd .
efi:ShortCircuitArc efi:producesDamage efi:ArcBead , efi:ArcMeltMark , efi:LargeMeltMark , efi:Spatter .
efi:CrushInducedArc efi:producesDamage efi:ArcBead , efi:ArcMeltMark , efi:MechanicalDeformation , efi:WholeConductorCrushedOrCut , efi:LargeMeltMark , efi:Spatter , efi:InsulationCarbonization .
efi:InsulationBreakdownArc efi:producesDamage efi:ArcMeltMark , efi:ArcBead , efi:InsulationEmbrittlement , efi:InsulationCarbonization , efi:LocalizedDiscoloration .
efi:ArcTracking efi:producesDamage efi:CarbonizedConductivePath , efi:BurnCenterOnSurface , efi:InsulationCarbonization , efi:ArcBead .
efi:LeakageCurrentHeating efi:producesDamage efi:InsulationCarbonization , efi:LocalizedDiscoloration .
efi:ExternalFlameExposure efi:producesDamage efi:GeneralMelting , efi:Sagging , efi:ThermalGradientFlow , efi:FireMeltMark , efi:SecondaryArcMark , efi:LargeMeltMark , efi:InsulationCarbonization .

# 발열 메커니즘 → 최초 착화물
efi:PoorContactHeating efi:ignites efi:InsulationMaterialFuel , efi:EnclosureMaterialFuel , efi:AccumulatedDustFuel .
efi:GlowingConnection efi:ignites efi:InsulationMaterialFuel , efi:EnclosureMaterialFuel , efi:CelluloseFuel .
efi:OverloadHeating efi:ignites efi:InsulationMaterialFuel , efi:ThermalInsulationFuel .
efi:ResistiveHeating efi:ignites efi:InsulationMaterialFuel .
efi:PartialDisconnectionHeating efi:ignites efi:InsulationMaterialFuel .
efi:SeriesArc efi:ignites efi:InsulationMaterialFuel , efi:AccumulatedDustFuel .
efi:ShortCircuitArc efi:ignites efi:InsulationMaterialFuel , efi:FlammableVaporFuel , efi:PaperTextileFuel , efi:AccumulatedDustFuel .
efi:CrushInducedArc efi:ignites efi:InsulationMaterialFuel , efi:PaperTextileFuel .
efi:InsulationBreakdownArc efi:ignites efi:InsulationMaterialFuel , efi:EnclosureMaterialFuel .
efi:ArcTracking efi:ignites efi:InsulationMaterialFuel , efi:EnclosureMaterialFuel , efi:AccumulatedDustFuel .
efi:LeakageCurrentHeating efi:ignites efi:InsulationMaterialFuel , efi:AccumulatedDustFuel .
efi:ExternalFlameExposure efi:ignites efi:AdjacentCombustible , efi:CelluloseFuel , efi:ThermalInsulationFuel .

# 물리 증거물 → 손상 양상
efi:Conductor efi:exhibits efi:ArcBead , efi:ArcMeltMark , efi:LargeMeltMark , efi:GeneralMelting , efi:Sagging , efi:MechanicalDeformation , efi:WholeConductorCrushedOrCut , efi:LocalizedDiscoloration .
efi:StrandedConductor efi:exhibits efi:StrandFracture , efi:StrandFractureAtStressPoint , efi:SmallMeltBallOnStrandEnd , efi:MultipleArcBeads .
efi:SolidConductor efi:exhibits efi:ArcBead , efi:MechanicalDeformation .
efi:Insulation efi:exhibits efi:InsulationCarbonization , efi:InsulationEmbrittlement , efi:CarbonizedConductivePath , efi:BurnCenterOnSurface , efi:ThermalGradientFlow .
efi:ConnectionPoint efi:exhibits efi:LocalizedDiscoloration , efi:CuprousOxideGrowth , efi:LossOfLuster , efi:LongTermTerminalHeating , efi:ArcBead .
efi:TerminalBlock efi:exhibits efi:LongTermTerminalHeating , efi:CarbonizedConductivePath , efi:CuprousOxideGrowth .
efi:PlugReceptacle efi:exhibits efi:CarbonizedConductivePath , efi:LocalizedDiscoloration , efi:LossOfLuster .
efi:Enclosure efi:exhibits efi:GeneralMelting , efi:Sagging , efi:FireMeltMark .
efi:ProtectiveDevice efi:exhibits efi:ArcMeltMark , efi:LocalizedDiscoloration .

# 현장 사실 → 선행 조건
efi:MoistureTrace efi:attests efi:MoistureExposure .
efi:ContaminationDeposit efi:attests efi:DustAccumulation , efi:ContaminatedEnvironment .
efi:ExternalForceTrace efi:attests efi:ExternalCrushing .
efi:ImmediateTripAfterExternalForce efi:attests efi:ExternalCrushing .
efi:NoTripDespiteExternalForce efi:attests efi:DeEnergizedState .
efi:FlexingHistoryWithStrandFracture efi:attests efi:RepeatedFlexing , efi:LongTermRepeatedStress .
efi:BreakerTripRecord efi:attests efi:EnergizedState .
efi:MultipleArcBeadsAtOrigin efi:attests efi:EnergizedState .
efi:NoArcOrSpatter efi:attests efi:DeEnergizedState .

# [M-3] 가설의 형태 발현을 메커니즘에서 유도해 대조한다.
#  선언된 canManifest 와 메커니즘의 producesDamage 가 어긋나면 근거 없는 선언이다.
efi:DerivedManifestationRuleShape a sh:NodeShape ; sh:targetSubjectsOf efi:hasDeclaredMechanism ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:derivedManifestation ?d . }
        WHERE { $this efi:hasDeclaredMechanism ?m . ?m efi:producesDamage ?d . }""" ] .

efi:hasDeclaredMechanism a owl:ObjectProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:HeatingMechanism ;
    rdfs:label "정의 메커니즘 (클래스 수준)"@ko ;
    rdfs:comment "hasMechanism 제한 공리를 클래스 수준에서 명시한 것. 형태 발현 유도에 사용."@ko .

efi:derivedManifestation a owl:ObjectProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:DamagePattern ;
    rdfs:label "메커니즘에서 유도된 손상 양상"@ko .

efi:PoorContactScenario efi:hasDeclaredMechanism efi:PoorContactHeating , efi:GlowingConnection .
efi:CrushDamageScenario efi:hasDeclaredMechanism efi:CrushInducedArc .
efi:PartialDisconnectionScenario efi:hasDeclaredMechanism efi:PartialDisconnectionHeating , efi:SeriesArc .
efi:InsulationDegradationScenario efi:hasDeclaredMechanism efi:InsulationBreakdownArc .
efi:TrackingScenario efi:hasDeclaredMechanism efi:ArcTracking , efi:LeakageCurrentHeating .
efi:ExternalFlameScenario efi:hasDeclaredMechanism efi:ExternalFlameExposure .

# ============================================================================
# 11. 정의로 도출되는 사실 (D-1~D-3)
#     임계값이 아니라 관계 비교다. 두 수치의 대소·동일 여부만으로 결정되므로
#     감별 루브릭이 없어도 성립한다. OWL 은 두 데이터 속성을 비교하지 못하므로
#     SHACL 로 쓴다.
#     축을 넘지 않는다 — 물리 증거물에 대한 판정은 물리 증거물 쪽에만 남긴다.
#     이 사실이 어느 선행 조건을 증언하는지는 루브릭 사항이며 여기서 정하지 않는다.
# ============================================================================
efi:loadExceedsRating a owl:DatatypeProperty ;
    rdfs:domain efi:ElectricalArtifact ; rdfs:range xsd:boolean ;
    rdfs:label "부하전류가 정격을 초과함"@ko ; skos:prefLabel "부하전류가 정격을 초과함"@ko ;
    rdfs:comment "loadCurrent_A > ratedCurrent_A 에서 도출. 과부하 '상태'(선행 조건)로 곧장 등치하지 않는다 — 축이 다르다."@ko .

# [D-1] 과부하 = 부하전류 > 정격전류
efi:OverloadDerivationRuleShape a sh:NodeShape ; sh:targetClass efi:ElectricalArtifact ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:loadExceedsRating true . }
        WHERE {
          $this efi:loadCurrent_A ?l ; efi:ratedCurrent_A ?r .
          FILTER ( ?l > ?r )
        }""" ] .

# [D-2] 부분단선 = 파단 소선이 있으나 전부는 아니다.
#  전부 파단인 경우는 여기서 판정하지 않는다 — '도체 전체 압착·절단'은 원인을 담은 이름이라
#  소선 수만으로 단정할 수 없다.
efi:StrandFractureDerivationRuleShape a sh:NodeShape ; sh:targetClass efi:StrandedConductor ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:exhibits efi:StrandFracture . }
        WHERE {
          $this efi:strandCount ?n ; efi:fracturedStrandCount ?f .
          FILTER ( ?f > 0 && ?f < ?n )
        }""" ] .

# [D-3] 아산화동 증식 = 접속부에서 아산화동이 확인됨
efi:CuprousOxideDerivationRuleShape a sh:NodeShape ; sh:targetClass efi:ConnectionPoint ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:exhibits efi:CuprousOxideGrowth . }
        WHERE { $this efi:cuprousOxidePresent true }""" ] .


# ============================================================================
# 12. NFPA 921 (2024) 조항 대조
#     방법론 층(SHACL 제약·규칙)에만 붙인다.
#     지표 규칙 25개는 NFPA 가 아니라 논문 Table 2 · 국내 실무·선행연구에서 왔다.
#     거기에 조항을 붙이면 출처가 왜곡되므로 붙이지 않는다.
#     절 수준까지만 대조했다 — 하위 절 번호는 원문 확인 후 좁힌다.
# ============================================================================
efi:FalsificationRuleShape dcterms:references
    "NFPA 921 (2024) §4.3 Relating to the Scientific Method" ,
    "NFPA 921 (2024) §19.6 Testing the Hypothesis for Validity" .
efi:ArcMarkSequenceRuleShape dcterms:references
    "NFPA 921 (2024) §9.11 Identification of Damaged Conductors" .
efi:IgnitionCompetenceRuleShape dcterms:references
    "NFPA 921 (2024) §9.9 Ignition by Electrical Energy" ,
    "NFPA 921 (2024) §19.6 Testing the Hypothesis for Validity" .
efi:SupportScoreRuleShape dcterms:references
    "NFPA 921 (2024) §19.6 Testing the Hypothesis for Validity" .
efi:RefutationEvidenceShape dcterms:references
    "NFPA 921 (2024) §19.6 Testing the Hypothesis for Validity" .
efi:ConclusionShape dcterms:references
    "NFPA 921 (2024) §19.7 Selecting the Final Hypothesis" .
efi:ScenarioShape dcterms:references
    "NFPA 921 (2024) §19.5 Developing Cause Hypotheses" .
efi:FactShape dcterms:references
    "NFPA 921 (2024) §19.3 Data Collection" .
efi:MorphologyDiscriminationRuleShape dcterms:references
    "NFPA 921 (2024) §9.10 Interpreting Damage to Elec. Systems" ,
    "NFPA 921 (2024) §19.4 Analyze the Data" .
efi:MorphologicalAmbiguityRuleShape dcterms:references
    "NFPA 921 (2024) §9.10 Interpreting Damage to Elec. Systems" ,
    "NFPA 921 (2024) §19.4 Analyze the Data" .
efi:MorphologyOnlyConclusionShape dcterms:references
    "NFPA 921 (2024) §9.10 Interpreting Damage to Elec. Systems" ,
    "NFPA 921 (2024) §19.7 Selecting the Final Hypothesis" .
efi:DerivedManifestationRuleShape dcterms:references
    "NFPA 921 (2024) §9.9 Ignition by Electrical Energy" ,
    "NFPA 921 (2024) §19.4 Analyze the Data" .
efi:OverloadDerivationRuleShape dcterms:references
    "NFPA 921 (2024) §9.6 Overcurrent Protection" .
efi:StrandFractureDerivationRuleShape dcterms:references
    "NFPA 921 (2024) §9.11 Identification of Damaged Conductors" .
efi:CuprousOxideDerivationRuleShape dcterms:references
    "NFPA 921 (2024) §9.10 Interpreting Damage to Elec. Systems" .

# ============================================================================
# 13. 아크 조사 (NFPA 921 §9.13)
#     회로의 아크 지점을 계통적으로 찾아 발화부 판정과 확산 경로 해석에 쓴다.
#     어휘(ArcMapPoint, locatedInOriginArea)만 있고 절차가 없던 부분을 채운다.
# ============================================================================
efi:ArcSurvey a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "아크 조사"@ko ; skos:prefLabel "아크 조사"@ko ;
    rdfs:comment "전기 계통의 아크 지점을 찾아 발화부 판정에 쓰는 조사 활동 (§9.13)"@ko .

efi:CorrespondingDamageArea a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "대응 손상 영역"@ko ; skos:prefLabel "대응 손상 영역"@ko ;
    rdfs:comment "같은 고장 회로에서 전위가 다른 도체 쪽에 대응해 나타나는 손상 (§9.13.4.2)"@ko .

efi:GroundFaultProtectiveDevice a owl:Class ; rdfs:subClassOf efi:ProtectiveDevice ;
    rdfs:label "누전차단기(GFCI)"@ko ; skos:prefLabel "누전차단기(GFCI)"@ko .
efi:ArcFaultProtectiveDevice a owl:Class ; rdfs:subClassOf efi:ProtectiveDevice ;
    rdfs:label "아크차단기(AFCI)"@ko ; skos:prefLabel "아크차단기(AFCI)"@ko .

efi:surveyComplete a owl:DatatypeProperty ; rdfs:domain efi:ArcSurvey ; rdfs:range xsd:boolean ;
    rdfs:label "아크 조사 완전 수행 여부"@ko ; skos:prefLabel "아크 조사 완전 수행 여부"@ko ;
    rdfs:comment "완전하지 않으면 결론은 실제 조사한 범위로 제한된다 (§9.13.1.2)"@ko .
efi:scopeLimitedTo a owl:DatatypeProperty ; rdfs:domain efi:Conclusion ; rdfs:range xsd:string ;
    rdfs:label "결론 적용 범위"@ko ; skos:prefLabel "결론 적용 범위"@ko .
efi:arcSiteFound a owl:DatatypeProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range xsd:boolean ;
    rdfs:label "아크 지점 발견 여부"@ko ; skos:prefLabel "아크 지점 발견 여부"@ko ;
    rdfs:comment "부재도 기록 대상이다. 조사하지 않은 것과 조사했으나 없는 것은 다르다 (§9.13.4.5)"@ko .
efi:obscuredByMelting a owl:DatatypeProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range xsd:boolean ;
    rdfs:label "용융으로 판독 불가"@ko ; skos:prefLabel "용융으로 판독 불가"@ko ;
    rdfs:comment "용융이 아크 지점을 지웠을 수 있다. 이 경우 부재는 부정 확인이 아니라 확인 불가다 (§9.13.4.6)"@ko .
efi:downstreamIndex a owl:DatatypeProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range xsd:integer ;
    rdfs:label "회로상 하류 순번"@ko ; skos:prefLabel "회로상 하류 순번"@ko ;
    rdfs:comment "한 회로에 아크 지점이 여럿이면 최하류 지점을 기록한다 (§9.13.2.1)"@ko .
efi:trueArcSiteLikely a owl:DatatypeProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range xsd:boolean ;
    rdfs:label "진성 아크 지점 가능성"@ko ; skos:prefLabel "진성 아크 지점 가능성"@ko .

efi:fromArcSurvey a owl:ObjectProperty ; rdfs:domain efi:Conclusion ; rdfs:range efi:ArcSurvey ;
    rdfs:label "아크 조사에 근거함"@ko ; skos:prefLabel "아크 조사에 근거함"@ko .
efi:hasCorrespondingDamage a owl:ObjectProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range efi:CorrespondingDamageArea ;
    rdfs:label "대응 손상을 가진다"@ko ; skos:prefLabel "대응 손상을 가진다"@ko .
efi:circuitProtection a owl:ObjectProperty ; rdfs:domain efi:ArcSurvey ; rdfs:range efi:ProtectiveDevice ;
    rdfs:label "회로 보호장치"@ko ; skos:prefLabel "회로 보호장치"@ko ;
    rdfs:comment "조사한 회로마다 보호장치 종류와 동작 상태를 기록한다 (§9.13.2.2)"@ko .

# [F-5] 아크흔 부재의 확인 상태. 조사한 결과 없음과 용융에 가려 못 봄을 가른다.
#  P4(결측 ≠ 확인 불가 ≠ 부정 확인)와 §9.13.4.5·§9.13.4.6 이 같은 요구를 한다.
efi:ArcSiteAbsenceRuleShape a sh:NodeShape ; sh:targetClass efi:ArcMapPoint ;
    dcterms:references "NFPA 921 (2024) §9.13.4.5 Documenting the Damage" ,
                       "NFPA 921 (2024) §9.13.4.6 Documenting the Damage" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:confirmationStatus efi:ConfirmedAbsent . }
        WHERE {
          $this efi:arcSiteFound false .
          FILTER NOT EXISTS { $this efi:obscuredByMelting true }
        }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:confirmationStatus efi:Unverifiable . }
        WHERE { $this efi:obscuredByMelting true }""" ] .

# [C-6] 용융에 가려진 지점을 부정 확인으로 쓰면 안 된다. 반증 근거가 되어버린다.
efi:ObscuredArcSiteShape a sh:NodeShape ; sh:targetClass efi:ArcMapPoint ;
    dcterms:references "NFPA 921 (2024) §9.13.4.6 Documenting the Damage" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "용융으로 판독 불가한 지점의 아크흔 부재는 확인 불가이지 부정 확인이 아니다 (§9.13.4.6)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:obscuredByMelting true .
          $this efi:confirmationStatus efi:ConfirmedAbsent .
        }""" ] .

# [C-7] 부분 아크 조사에 근거한 결론은 조사한 범위를 넘어설 수 없다.
efi:ArcSurveyScopeShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.13.1.2 Procedures and Limitations" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "완전하지 않은 아크 조사에 근거한 결론은 실제 조사한 범위를 명시해야 한다 (§9.13.1.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:fromArcSurvey ?s .
          ?s efi:surveyComplete false .
          FILTER NOT EXISTS { $this efi:scopeLimitedTo ?x }
        }""" ] .

# [C-8] 아크 용융흔 단독으로는 그 시점 통전 사실만 말한다. 발화원 결론이 되지 못한다.
efi:ArcMeltAloneShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.13.4.7 Documenting the Damage" ,
                       "NFPA 921 (2024) §9.11.6 Beaded Conductor" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "아크 용융흔은 그 시점 통전 사실만 증언한다. 발화부 근접 여부와 발화원 자격에는 별도 자료가 필요하다 (§9.13.4.7)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          FILTER EXISTS { ?sc efi:supportedBy ?f . ?f rdf:type/rdfs:subClassOf* efi:ArcMeltMark }
          FILTER NOT EXISTS {
            ?sc efi:supportedBy ?g .
            ?g efi:confirmationStatus efi:Confirmed .
            FILTER NOT EXISTS { ?g rdf:type/rdfs:subClassOf* efi:ArcMeltMark }
          }
        }""" ] .

# [D-4] 전위가 다른 쪽에 대응 손상이 둘 이상 확인되면 진성 아크 지점일 확률이 오른다.
efi:CorrespondingDamageRuleShape a sh:NodeShape ; sh:targetClass efi:ArcMapPoint ;
    dcterms:references "NFPA 921 (2024) §9.13.4.2 Documenting the Damage" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:trueArcSiteLikely true . }
        WHERE {
          { SELECT $this (COUNT(DISTINCT ?d) AS ?n) WHERE { $this efi:hasCorrespondingDamage ?d . } GROUP BY $this }
          FILTER ( ?n >= 2 )
        }""" ] .

# 회로 (§9.7). 아크 지점의 하류 순번은 회로 단위로만 뜻이 있다.
efi:Circuit a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ;
    rdfs:label "회로"@ko ; skos:prefLabel "회로"@ko .
efi:BranchCircuit a owl:Class ; rdfs:subClassOf efi:Circuit ;
    rdfs:label "분기회로"@ko ; skos:prefLabel "분기회로"@ko .
efi:onCircuit a owl:ObjectProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range efi:Circuit ;
    rdfs:label "소속 회로"@ko ; skos:prefLabel "소속 회로"@ko .
efi:furthestDownstream a owl:DatatypeProperty ; rdfs:domain efi:ArcMapPoint ; rdfs:range xsd:boolean ;
    rdfs:label "회로 최하류 아크 지점"@ko ; skos:prefLabel "회로 최하류 아크 지점"@ko .

# [D-5] 한 회로에 아크 지점이 여럿이면 최하류 지점을 표시한다 (§9.13.2.1).
efi:FurthestDownstreamRuleShape a sh:NodeShape ; sh:targetClass efi:ArcMapPoint ;
    dcterms:references "NFPA 921 (2024) §9.13.2.1 Arc Map" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:furthestDownstream true . }
        WHERE {
          $this efi:onCircuit ?c ; efi:downstreamIndex ?i .
          FILTER NOT EXISTS {
            ?o efi:onCircuit ?c ; efi:downstreamIndex ?j .
            FILTER ( ?j > ?i )
          }
        }""" ] .

# ============================================================================
# 14. 화재 분류 (NFPA 921 §19.8)
#     분류는 원인 판정과 다른 일이며 원인 판정이 끝난 뒤에 온다 (§19.8.2).
#     범주 목록은 이 온톨로지가 정하지 않는다 — 관할이 쓰는 외부 분류 체계를
#     참조하도록만 한다 (§19.8.1). 범주를 여기서 열거하면 체계마다 다른 정의를
#     하나로 뭉개게 된다.
# ============================================================================
efi:ClassificationSystem a owl:Class ; rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "화재 분류 체계"@ko ; skos:prefLabel "화재 분류 체계"@ko ;
    rdfs:comment "사건·원인 분류에 쓰는 외부 체계. 정의와 라벨은 체계마다 다르다 (§19.8.1)"@ko .

efi:NFIRS a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "NFIRS (미국 화재사고 보고체계)"@ko .
efi:NFPA901 a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "NFPA 901 (화재 자료 분류 표준)"@ko .
efi:BATS a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "ATF BATS (폭발·방화 추적체계)"@ko .
efi:UCR a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "FBI UCR (통합 범죄 보고)"@ko .
efi:NIBRS a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "FBI NIBRS (사건 기반 보고체계)"@ko .
efi:CanadianFireLossStatistics a owl:NamedIndividual , efi:ClassificationSystem ;
    skos:prefLabel "캐나다 화재손실 통계 분류"@ko .

efi:FireClassification a owl:Class ; rdfs:subClassOf obo:IAO_0000030 , prov:Entity ;
    rdfs:label "화재 분류"@ko ; skos:prefLabel "화재 분류"@ko .
efi:IncidentClassification a owl:Class ; rdfs:subClassOf efi:FireClassification ;
    rdfs:label "사건 분류(통계 목적)"@ko ; skos:prefLabel "사건 분류(통계 목적)"@ko ;
    rdfs:comment "통계·보고 목적의 사건 분류. 원인 판정과 다른 일이다 (§19.8.1)"@ko .
efi:FireCauseClassification a owl:Class ; rdfs:subClassOf efi:FireClassification ;
    rdfs:label "화재 원인 분류(보고서 목적)"@ko ; skos:prefLabel "화재 원인 분류(보고서 목적)"@ko ;
    rdfs:comment "원인이 판정된 뒤 그 결과에 범주를 부여하는 절차 (§19.8.2)"@ko .

# 분류는 감별 의견이 아니다. 섞이면 '분류했으니 원인을 밝혔다'가 되어버린다.
[] a owl:AllDisjointClasses ; owl:members ( efi:Conclusion efi:FireClassification ) .

efi:usesClassificationSystem a owl:ObjectProperty ;
    rdfs:domain efi:FireClassification ; rdfs:range efi:ClassificationSystem ;
    rdfs:label "사용한 분류 체계"@ko ; skos:prefLabel "사용한 분류 체계"@ko .
efi:classificationCategory a owl:DatatypeProperty ;
    rdfs:domain efi:FireClassification ; rdfs:range xsd:string ;
    rdfs:label "분류 범주"@ko ; skos:prefLabel "분류 범주"@ko ;
    rdfs:comment "체계가 정의한 라벨을 그대로 적는다. 이 온톨로지는 범주를 정의하지 않는다"@ko .
efi:classifiesCause a owl:ObjectProperty ;
    rdfs:domain efi:FireCauseClassification ; rdfs:range efi:Conclusion ;
    rdfs:label "분류 대상 감별 의견"@ko ; skos:prefLabel "분류 대상 감별 의견"@ko .
efi:classifiesIncident a owl:ObjectProperty ;
    rdfs:domain efi:IncidentClassification ; rdfs:range efi:InvestigationSession ;
    rdfs:label "분류 대상 사건"@ko ; skos:prefLabel "분류 대상 사건"@ko .

# [C-9] 원인 분류는 원인 판정이 끝난 뒤에 온다 (§19.8.2).
efi:CauseClassificationOrderShape a sh:NodeShape ; sh:targetClass efi:FireCauseClassification ;
    dcterms:references "NFPA 921 (2024) §19.8.2 Fire Cause Classification for Reports" ;
    sh:property [ sh:path efi:classifiesCause ; sh:minCount 1 ; sh:class efi:Conclusion ;
        sh:message "원인 분류는 확정된 감별 의견을 가리켜야 한다. 분류가 판정을 대신할 수 없다 (§19.8.2)"@ko ] .

# [C-10] 분류는 어떤 체계의 정의를 쓴 것인지 밝혀야 한다 (§19.8.1).
#  체계마다 범주 정의가 다르므로 체계를 빼면 범주 라벨만으로는 뜻이 정해지지 않는다.
efi:ClassificationSystemShape a sh:NodeShape ; sh:targetClass efi:FireClassification ;
    dcterms:references "NFPA 921 (2024) §19.8.1 Incident Classification for Statistical Purposes" ;
    sh:property [ sh:path efi:usesClassificationSystem ; sh:minCount 1 ;
        sh:message "어떤 분류 체계의 정의를 쓴 것인지 밝혀야 한다. 체계마다 범주 정의가 다르다 (§19.8.1)"@ko ] .

# [C-11] 감별 의견 자체에 분류 범주를 달지 않는다.
#  분류와 판정을 한 칸에 쓰면 통계 라벨이 원인 판정으로 읽힌다 (§19.8.1).
efi:ConclusionNotClassifiedShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §19.8.1 Incident Classification for Statistical Purposes" ;
    sh:property [ sh:path efi:classificationCategory ; sh:maxCount 0 ;
        sh:message "감별 의견에 분류 범주를 직접 달 수 없다. 분류는 별도 개체로 두고 이 의견을 가리키게 한다 (§19.8)"@ko ] .

# ============================================================================
# 15. 의견 확신도 (NFPA 921 §4.5)
#     '개연(probable)'은 확률값이 아니라 경합 가설 대비 유일하게 앞선 상태로
#     구현한다. supportScore 를 확률로 읽으면 논문 3.2절 원칙을 깨뜨린다.
# ============================================================================
efi:CertaintyLevel a owl:Class ; rdfs:label "의견 확신도"@ko ; skos:prefLabel "의견 확신도"@ko ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( efi:Suspected efi:Possible efi:Probable ) ] .
efi:Suspected a owl:NamedIndividual , efi:CertaintyLevel ; skos:prefLabel "의심 수준"@ko ;
    rdfs:comment "전문가 의견의 요건을 갖추지 못한다 (§4.5.1.2)"@ko .
efi:Possible a owl:NamedIndividual , efi:CertaintyLevel ; skos:prefLabel "가능(possible)"@ko ;
    rdfs:comment "성립 가능함은 보였으나 배제도 개연 선언도 못 한 상태. 대등한 가설이 둘 이상이면 여기까지다 (§4.5.1.1)"@ko .
efi:Probable a owl:NamedIndividual , efi:CertaintyLevel ; skos:prefLabel "개연(probable)"@ko ;
    rdfs:comment "그렇지 않을 때보다 그럴 때가 더 그럴듯한 상태. 이때만 상당한 확실성으로 표현할 수 있다 (§4.5.1.2)"@ko .

efi:certaintyLevel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain efi:Conclusion ; rdfs:range efi:CertaintyLevel ;
    rdfs:label "확신도를 가진다"@ko ; skos:prefLabel "확신도를 가진다"@ko .
efi:statedLimitation a owl:DatatypeProperty ; rdfs:domain efi:Conclusion ; rdfs:range xsd:string ;
    rdfs:label "명시한 한계"@ko ; skos:prefLabel "명시한 한계"@ko ;
    rdfs:comment "아는 한계는 밝혀야 한다 (§4.5)"@ko .

efi:MaterialsAnalyst a owl:Class ; rdfs:subClassOf prov:Agent , sosa:Sensor ;
    rdfs:label "재료·금속조직 분석자"@ko ; skos:prefLabel "재료·금속조직 분석자"@ko ;
    rdfs:comment "도체 이상이 아크에 의한 것인지 다른 손상인지 판정을 돕는다 (§9.13.1.3)"@ko .

# [C-12] 대등한 가설이 둘 이상이면 개연이라 할 수 없다 (§4.5.1.1(2)).
#  점수가 확률이 아니므로 크기 비교가 아니라 '유일하게 앞서는가'만 본다.
efi:EqualLikelihoodShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.5.1.1 Expressions of Certainty" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "같은 세션에 대등하거나 더 앞선 가설이 남아 있다. 개연이 아니라 가능으로 표현해야 한다 (§4.5.1.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:certaintyLevel efi:Probable ; efi:concludes ?sc .
          ?sc efi:inSession ?s ; efi:supportScore ?n .
          ?o  efi:inSession ?s ; efi:supportScore ?m .
          FILTER ( ?o != ?sc && ?m >= ?n )
          FILTER NOT EXISTS { ?o efi:verdict efi:Refuted }
        }""" ] .

# [C-13] 의심 수준은 전문가 의견이 아니다 (§4.5.1.2).
efi:SuspectedNotOpinionShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.5.1.2 Expressions of Certainty" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "의심 수준은 전문가 의견의 요건을 갖추지 못한다. 감별 의견으로 낼 수 없다 (§4.5.1.2)"@ko ;
        sh:select """SELECT $this WHERE { $this efi:certaintyLevel efi:Suspected }""" ] .

# [C-14] 확신도를 밝히지 않은 의견은 낼 수 없다.
#  개연일 때만 상당한 확실성으로 표현할 수 있으므로 수준 표기가 곧 의견의 일부다 (§4.5.1.2).
efi:CertaintyStatedShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.5.1.2 Expressions of Certainty" ;
    sh:property [ sh:path efi:certaintyLevel ; sh:minCount 1 ;
        # 권고 — §4.5.1.2 should an opinion be expressed
        sh:severity sh:Warning ;
        sh:message "의견에는 확신도를 밝혀야 한다. 가능인지 개연인지 적지 않으면 상당한 확실성으로 읽힌다 (§4.5.1.2)"@ko ] .

# [C-15] 아는 한계는 밝혀야 한다 (§4.5).
#  확인 불가 사실이 있는데 한계 표기가 없으면 그 사실이 없었던 것처럼 읽힌다.
efi:LimitationDisclosureShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.5 Expert Opinions" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "확인 불가 사실이 있는 세션의 의견은 그 한계를 명시해야 한다 (§4.5)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:inSession ?s .
          ?s efi:hasFact ?f .
          ?f efi:confirmationStatus efi:Unverifiable .
          FILTER NOT EXISTS { $this efi:statedLimitation ?l }
        }""" ] .

# [C-16] 상당한 확실성은 유일한 최종 가설에서만 나온다 (§4.5.2).
efi:UniqueFinalHypothesisShape a sh:NodeShape ; sh:targetClass efi:InvestigationSession ;
    dcterms:references "NFPA 921 (2024) §4.5.2 Fire Investigation Certainty" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "한 세션에 개연 수준 의견이 둘 이상이다. 최종 가설은 유일해야 한다 (§4.5.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          ?c1 efi:certaintyLevel efi:Probable ; efi:concludes ?s1 .
          ?c2 efi:certaintyLevel efi:Probable ; efi:concludes ?s2 .
          ?s1 efi:inSession $this .
          ?s2 efi:inSession $this .
          FILTER ( ?c1 != ?c2 )
        }""" ] .

# ============================================================================
# 16. 검토 절차 (NFPA 921 §4.6) · 보고 (§4.7)
#     세 검토는 이름이 다른 게 아니라 보증하는 것이 다르다.
#     행정 검토 = 절차·서류 구비 여부. 실질 비평을 하지 못한다 (§4.6.1.1)
#     기술 검토 = 실질 비평. 자격과 자료 접근이 전제 (§4.6.2)
#     동료 검토 = 독립성·객관성. 결과에 이해관계가 없어야 한다 (§4.6.3)
# ============================================================================
efi:WorkProductReview a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "조사 결과물 검토"@ko ; skos:prefLabel "조사 결과물 검토"@ko .
efi:AdministrativeReview a owl:Class ; rdfs:subClassOf efi:WorkProductReview ;
    rdfs:label "행정 검토"@ko ; skos:prefLabel "행정 검토"@ko ;
    rdfs:comment "절차 준수와 서류 구비를 본다. 실질 비평을 제공하지 못할 수 있다 (§4.6.1.1)"@ko .
efi:TechnicalReview a owl:Class ; rdfs:subClassOf efi:WorkProductReview ;
    rdfs:label "기술 검토"@ko ; skos:prefLabel "기술 검토"@ko ;
    rdfs:comment "결과물의 실질을 비평한다. 검토자 자격과 자료 접근이 전제다 (§4.6.2)"@ko .
efi:PeerReview a owl:Class ; rdfs:subClassOf efi:WorkProductReview ;
    rdfs:label "동료 검토"@ko ; skos:prefLabel "동료 검토"@ko ;
    rdfs:comment "독립성과 객관성을 함의한다. 검토자는 결과에 이해관계가 없어야 하고 저자가 검토자를 고르지 않는다 (§4.6.3)"@ko .
[] a owl:AllDisjointClasses ; owl:members ( efi:AdministrativeReview efi:TechnicalReview efi:PeerReview ) .

efi:InvestigationReport a owl:Class ; rdfs:subClassOf obo:IAO_0000030 , prov:Entity ;
    rdfs:label "조사 보고"@ko ; skos:prefLabel "조사 보고"@ko ;
    rdfs:comment "형식과 전달 경로는 조사자의 소관에 따라 달라진다. 여기서 열거하지 않는다 (§4.7)"@ko .

efi:reviews a owl:ObjectProperty ; rdfs:domain efi:WorkProductReview ; rdfs:range efi:InvestigationSession ;
    rdfs:label "검토 대상 세션"@ko ; skos:prefLabel "검토 대상 세션"@ko .
efi:reviewer a owl:ObjectProperty ; rdfs:domain efi:WorkProductReview ; rdfs:range prov:Agent ;
    rdfs:label "검토자"@ko ; skos:prefLabel "검토자"@ko .
efi:participatedIn a owl:ObjectProperty ; rdfs:domain prov:Agent ; rdfs:range efi:InvestigationSession ;
    rdfs:label "해당 조사에 참여함"@ko ; skos:prefLabel "해당 조사에 참여함"@ko .
efi:reviewerSelectedByAuthor a owl:DatatypeProperty ; rdfs:domain efi:WorkProductReview ; rdfs:range xsd:boolean ;
    rdfs:label "저자가 검토자를 지정함"@ko ; skos:prefLabel "저자가 검토자를 지정함"@ko .
efi:hasDocumentationAccess a owl:DatatypeProperty ; rdfs:domain efi:WorkProductReview ; rdfs:range xsd:boolean ;
    rdfs:label "검토자 자료 접근 확보"@ko ; skos:prefLabel "검토자 자료 접근 확보"@ko .
efi:providesSubstantiveCritique a owl:DatatypeProperty ; rdfs:domain efi:WorkProductReview ; rdfs:range xsd:boolean ;
    rdfs:label "실질 비평을 제공함"@ko ; skos:prefLabel "실질 비평을 제공함"@ko .
efi:reviewValidated a owl:DatatypeProperty ; rdfs:domain efi:Conclusion ; rdfs:range xsd:boolean ;
    rdfs:label "검토로 타당성을 확인함"@ko ; skos:prefLabel "검토로 타당성을 확인함"@ko .
efi:reportsConclusion a owl:ObjectProperty ; rdfs:domain efi:InvestigationReport ; rdfs:range efi:Conclusion ;
    rdfs:label "보고 대상 의견"@ko ; skos:prefLabel "보고 대상 의견"@ko .

# [C-17] 같은 조사에 참여했거나 저자가 고른 검토자의 검토는 동료 검토가 아니다.
#  §4.6.3 은 그런 검토를 기술 검토로 부르라고 한다. 이름을 잘못 붙이면 독립성을
#  갖추지 못한 검토가 독립 검토로 인용된다.
efi:PeerReviewIndependenceShape a sh:NodeShape ; sh:targetClass efi:PeerReview ;
    dcterms:references "NFPA 921 (2024) §4.6.3 Peer Review" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "결과에 이해관계가 있거나 저자가 지정한 검토자의 검토는 동료 검토가 아니라 기술 검토다 (§4.6.3)"@ko ;
        sh:select """
        SELECT $this WHERE {
          { $this efi:reviews ?s ; efi:reviewer ?r . ?r efi:participatedIn ?s . }
          UNION
          { $this efi:reviewerSelectedByAuthor true . }
        }""" ] .

# [C-18] 행정 검토는 실질 비평이 아니다 (§4.6.1.1).
efi:AdministrativeReviewScopeShape a sh:NodeShape ; sh:targetClass efi:AdministrativeReview ;
    dcterms:references "NFPA 921 (2024) §4.6.1.1 Limitations of Administrative Reviews" ;
    sh:property [ sh:path efi:providesSubstantiveCritique ; sh:maxCount 1 ; sh:hasValue false ;
        sh:message "행정 검토는 절차와 서류를 볼 뿐 실질 비평을 제공하지 못한다 (§4.6.1.1)"@ko ] .

# [C-19] 기술 검토는 검토 대상 자료에 접근할 수 있어야 성립한다 (§4.6.2).
efi:TechnicalReviewAccessShape a sh:NodeShape ; sh:targetClass efi:TechnicalReview ;
    dcterms:references "NFPA 921 (2024) §4.6.2 Technical Review" ;
    sh:property [ sh:path efi:hasDocumentationAccess ; sh:minCount 1 ; sh:hasValue true ;
        sh:message "기술 검토는 최소한 검토 대상 자료에 접근할 수 있어야 한다 (§4.6.2)"@ko ] .

# [C-20] 결과의 타당성 확인은 기술 검토로만 주장할 수 있다 (§4.6.3.2).
#  동료 검토자는 논리 결함은 잡아도 자료 오류는 잡을 근거가 없다.
#  잘못된 자료 위의 결론은 잘못될 수밖에 없다.
efi:ReviewValidationShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.6.3.2 Limitations of Peer Reviews" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "검토로 타당성을 확인했다고 하려면 기술 검토가 있어야 한다. 동료 검토는 자료 오류를 잡지 못한다 (§4.6.3.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:reviewValidated true ; efi:concludes ?sc .
          ?sc efi:inSession ?s .
          FILTER NOT EXISTS { ?t a efi:TechnicalReview ; efi:reviews ?s . }
        }""" ] .

# ============================================================================
# 17. 인입 계통·접지 (NFPA 921 §9.3~§9.6)
#     전압·인입 방식·계량기는 배경 지식이라 넣지 않는다. 넣어도 판정에 쓰이지 않아
#     어휘만 남는다. 감식에 실제로 쓰이는 셋만 옮긴다.
#       §9.3.4  인입구는 과전류 보호가 없어 고장이 지속된다
#       §9.5.1.1 본딩은 저임피던스 경로로 보호장치를 제때 동작시킨다
#       §9.5.2  중성선 단선은 과전압을 만들고, 접지극 제거가 그 원인이 아니다
# ============================================================================

# 용어 정렬 (§9.3.2.1.2). 실무에서 쓰는 말과 표준 용어가 다르다.
efi:UngroundedConductor a owl:Class ; rdfs:subClassOf efi:Conductor ;
    rdfs:label "비접지 도체"@ko ; skos:prefLabel "비접지 도체"@ko ;
    skos:altLabel "핫"@ko , "hot"@en , "Ungrounded conductor"@en ;
    rdfs:comment "현장에서 흔히 '핫'이라 부르나 표준 용어는 비접지 도체다 (§9.3.2.1.2)"@ko .
efi:GroundedConductor a owl:Class ; rdfs:subClassOf efi:Conductor ;
    rdfs:label "접지측 도체"@ko ; skos:prefLabel "접지측 도체"@ko ;
    skos:altLabel "중성선"@ko , "neutral"@en , "Grounded conductor"@en ;
    rdfs:comment "현장에서 흔히 '중성선'이라 부르나 표준 용어는 접지측 도체다 (§9.3.2.1.2)"@ko .
efi:GroundingConductor a owl:Class ; rdfs:subClassOf efi:Conductor ;
    rdfs:label "접지 도체"@ko ; skos:prefLabel "접지 도체"@ko ;
    skos:altLabel "접지선"@ko , "ground"@en , "Grounding conductor"@en .

efi:ServiceEntrance a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ;
    rdfs:label "인입구"@ko ; skos:prefLabel "인입구"@ko ;
    rdfs:comment "변압기와 건물 주보호장치 사이 구간. 통상 과전류 보호가 없어 고장이 시작되면 지속된다 (§9.3.4)"@ko .
efi:ServiceEquipment a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ;
    rdfs:label "인입 개폐기"@ko ; skos:prefLabel "인입 개폐기"@ko ;
    rdfs:comment "전체 차단·보호·분기 세 기능을 한다 (§9.4)"@ko .
efi:BondingPath a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ;
    rdfs:label "본딩 경로"@ko ; skos:prefLabel "본딩 경로"@ko ;
    rdfs:comment "지락 시 저임피던스 귀로를 만들어 보호장치를 제때 동작시킨다 (§9.5.1.1)"@ko .

efi:OpenNeutral a owl:Class ; rdfs:subClassOf efi:ElectricalState ;
    rdfs:label "중성선 단선"@ko ; skos:prefLabel "중성선 단선"@ko ;
    skos:altLabel "부동 중성선"@ko , "floating neutral"@en , "open neutral"@en ;
    rdfs:comment "두 다리의 전압이 120 V 로 고정되지 않고 합이 240 V 인 다른 값으로 갈린다. 부하에 따라 변한다 (§9.5.2)"@ko .
efi:OpenNeutralOvervoltage a owl:Class ; rdfs:subClassOf efi:ElectricalHeatingMechanism ;
    rdfs:label "중성선 단선 과전압 발열"@ko ; skos:prefLabel "중성선 단선 과전압 발열"@ko ;
    rdfs:comment "높은 쪽 다리의 과전압이 기기를 과열시킨다. 5대 요인 외 확장 슬롯 (§9.5.2)"@ko .
efi:SustainedFaulting a owl:Class ; rdfs:subClassOf efi:ElectricalHeatingMechanism ;
    rdfs:label "지속 고장 발열"@ko ; skos:prefLabel "지속 고장 발열"@ko ;
    rdfs:comment "과전류 보호가 없는 구간에서 단락·지락이 끊기지 않고 이어져 가연물을 착화시킨다 (§9.3.4)"@ko .

# 거주자 진술 — 중성선 단선의 비형태 단서 (§9.5.2)
efi:AbnormalLampBrightnessReport a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "조명 밝기 이상 진술"@ko ; skos:prefLabel "조명 밝기 이상 진술"@ko ;
    rdfs:comment "백열등이 지나치게 밝거나 어두웠다는 진술 (§9.5.2)"@ko .
efi:MultipleApplianceMalfunction a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "복수 기기 과열·오작동"@ko ; skos:prefLabel "복수 기기 과열·오작동"@ko ;
    rdfs:comment "여러 기기가 동시에 과열되거나 오작동했다는 진술 (§9.5.2)"@ko .

efi:AbnormalLampBrightnessReport efi:attests efi:OpenNeutral .
efi:MultipleApplianceMalfunction efi:attests efi:OpenNeutral .
efi:OpenNeutral efi:enables efi:OpenNeutralOvervoltage .

efi:overcurrentProtected a owl:DatatypeProperty ; rdfs:domain efi:ElectricalArtifact ; rdfs:range xsd:boolean ;
    rdfs:label "상류 과전류 보호 있음"@ko ; skos:prefLabel "상류 과전류 보호 있음"@ko .
efi:sustainedFaultingPossible a owl:DatatypeProperty ; rdfs:domain efi:ElectricalArtifact ; rdfs:range xsd:boolean ;
    rdfs:label "지속 고장 가능 구간"@ko ; skos:prefLabel "지속 고장 가능 구간"@ko .
efi:GroundingElectrodeDisconnection a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "접지극 연결 제거 흔적"@ko ; skos:prefLabel "접지극 연결 제거 흔적"@ko ;
    rdfs:comment "중성선 단선과 무관하다. 이 사실로 중성선 단선을 증언할 수 없다 (§9.5.2)"@ko .
efi:protectiveDeviceOperated a owl:DatatypeProperty ; rdfs:domain efi:ElectricalArtifact ; rdfs:range xsd:boolean ;
    rdfs:label "보호장치 동작함"@ko ; skos:prefLabel "보호장치 동작함"@ko .

# [D-6] 과전류 보호가 없는 구간에서는 고장이 지속될 수 있다 (§9.3.4).
#  인입구는 정의상 여기 해당한다.
efi:SustainedFaultingRuleShape a sh:NodeShape ; sh:targetClass efi:ElectricalArtifact ;
    dcterms:references "NFPA 921 (2024) §9.3.4 Significance" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:sustainedFaultingPossible true . }
        WHERE { $this efi:overcurrentProtected false }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:sustainedFaultingPossible true . }
        WHERE { $this a efi:ServiceEntrance . }""" ] .

# [C-21] 접지극 연결 제거는 중성선 단선의 원인이 아니다 (§9.5.2).
#  원문이 명시적으로 경고하는 잘못된 추론이다. 구조로 막는다.
efi:OpenNeutralInferenceShape a sh:NodeShape ; sh:targetSubjectsOf efi:attests ;
    dcterms:references "NFPA 921 (2024) §9.5.2 Floating Neutral (Open Neutral)" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "접지극 연결 제거를 근거로 중성선 단선을 판단할 수 없다. 중성선 단선은 접지 상태와 무관하다 (§9.5.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:attests ?o .
          { { $this rdfs:subClassOf* efi:GroundingElectrodeDisconnection }
            UNION { $this rdf:type/rdfs:subClassOf* efi:GroundingElectrodeDisconnection } }
          { { ?o rdfs:subClassOf* efi:OpenNeutral }
            UNION { ?o rdf:type/rdfs:subClassOf* efi:OpenNeutral } }
        }""" ] .

# [C-22] 보호된 구간에서 지속 고장을 주장하려면 보호장치가 왜 동작하지 않았는지 밝혀야 한다.
#  보호장치는 자동 동작이 요건이다 (§9.6.1). 동작했는데 지속됐다면 설명이 필요하다.
efi:ProtectedSustainedFaultShape a sh:NodeShape ; sh:targetClass efi:ElectricalArtifact ;
    dcterms:references "NFPA 921 (2024) §9.6.1 Overcurrent Protection" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "보호된 구간에서 지속 고장을 주장하려면 보호장치 미동작 근거가 있어야 한다 (§9.6.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:sustainedFaultingPossible true ; efi:overcurrentProtected true .
          FILTER NOT EXISTS { $this efi:protectiveDeviceOperated false }
        }""" ] .

# ============================================================================
# 18. 과학적 방법 (NFPA 921 §4.3)
#     반증 우선(P3)은 §4.3.6 에서 이미 가져왔다. 여기서는 그 앞뒤 요건을 채운다.
#       §4.3.4   수집한 자료는 최종 가설 형성 전에 전부 분석돼야 한다
#       §4.3.6   모든 가설을 시험해 유일하게 정합적인 하나가 남을 때까지 계속한다
#                하나도 견디지 못하면 원인미상으로 둔다
#       §4.3.6.1 자료 부재 위에 세운 가설은 시험 불가능하므로 무효다
#                반증되지 않았다는 것이 참이라는 뜻은 아니다
#       §4.3.7   대안 가설을 고려하지 않는 것은 중대한 오류다
#       §4.3.8   자료가 모이기 전에는 어떤 가설도 세우거나 시험할 수 없다
# ============================================================================
efi:analyzed a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "분석 완료"@ko ; skos:prefLabel "분석 완료"@ko ;
    rdfs:comment "수집·목록화는 분석이 아니다. 자료에 의미를 부여한 상태를 뜻한다 (§4.3.4)"@ko .
efi:outcomeUndetermined a owl:DatatypeProperty ; rdfs:domain efi:InvestigationSession ; rdfs:range xsd:boolean ;
    rdfs:label "원인미상 처리"@ko ; skos:prefLabel "원인미상 처리"@ko ;
    rdfs:comment "연역적 검토를 견딘 가설이 하나도 없으면 원인미상으로 둔다 (§4.3.6)"@ko .

# [C-23] 자료 부재 위에 세운 가설은 시험할 수 없으므로 무효다 (§4.3.6.1).
#  부정 확인과 확인 불가만으로 지지된 가설이 여기 해당한다.
#  반증되지 않았다는 것은 참이라는 뜻이 아니다.
efi:UntestableHypothesisShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.3.6.1 Test the Hypotheses" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "존재가 확인된 사실이 하나도 없다. 부재 위에 세운 가설은 시험할 수 없어 무효다 (§4.3.6.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          FILTER EXISTS { ?sc efi:supportedBy ?f }
          FILTER NOT EXISTS { ?sc efi:supportedBy ?g . ?g efi:confirmationStatus efi:Confirmed }
        }""" ] .

# [C-24] 대안 가설을 고려하지 않는 것은 중대한 오류다 (§4.3.7).
#  결론 전에 세션의 모든 가설이 시험돼 판정을 가지고 있어야 한다.
efi:AllHypothesesTestedShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.3.7 Select Final Hypothesis" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "판정되지 않은 가설이 남아 있다. 대안 가설을 고려하지 않는 것은 중대한 오류다 (§4.3.7)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:inSession ?s .
          ?h efi:inSession ?s .
          FILTER NOT EXISTS { ?h efi:verdict ?v }
        }""" ] .

# [C-25] 어느 가설도 연역적 검토를 견디지 못하면 원인미상이다 (§4.3.6).
efi:UndeterminedOutcomeShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §4.3.6 Test the Hypotheses" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "모든 가설이 기각됐다. 결론을 낼 것이 아니라 원인미상으로 두어야 한다 (§4.3.6)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:inSession ?s .
          FILTER NOT EXISTS {
            ?h efi:inSession ?s .
            FILTER NOT EXISTS { ?h efi:verdict efi:Refuted }
          }
        }""" ] .

# [C-26] 수집한 자료는 최종 가설이 서기 전에 전부 분석돼야 한다 (§4.3.4).
#  수집과 목록화는 분석이 아니다.
efi:DataAnalyzedShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §4.3.4 Analyze the Data" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "분석되지 않은 자료가 남아 있다. 수집한 자료는 최종 가설 전에 전부 분석돼야 한다 (§4.3.4)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:inSession ?s .
          ?s efi:hasFact ?f .
          FILTER NOT EXISTS { ?f efi:analyzed true }
        }""" ] .

# [C-27] 자료가 모이기 전에는 어떤 가설도 판정할 수 없다 (§4.3.8).
efi:NoPresumptionShape a sh:NodeShape ; sh:targetClass efi:IgnitionScenario ;
    dcterms:references "NFPA 921 (2024) §4.3.8 Avoid Presumption" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "자료가 하나도 수집되지 않은 세션에서 가설을 판정했다. 예단 없이 접근해야 한다 (§4.3.8)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:verdict ?v ; efi:inSession ?s .
          FILTER NOT EXISTS { ?s efi:hasFact ?f }
        }""" ] .

# [D-7] 어느 가설도 견디지 못한 세션은 원인미상으로 판정한다 (§4.3.6).
#  판단보류가 결론의 부재가 아니라 하나의 결과라는 점을 구조로 남긴다.
efi:UndeterminedDerivationRuleShape a sh:NodeShape ; sh:targetClass efi:InvestigationSession ;
    dcterms:references "NFPA 921 (2024) §4.3.6 Test the Hypotheses" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 5 ;
        sh:construct """
        CONSTRUCT { $this efi:outcomeUndetermined true . }
        WHERE {
          FILTER EXISTS { ?h efi:inSession $this }
          FILTER NOT EXISTS {
            ?h2 efi:inSession $this .
            FILTER NOT EXISTS { ?h2 efi:verdict efi:Refuted }
          }
        }""" ] .

# ============================================================================
# 19. 원인 가설 수립·검증 (NFPA 921 §19.4~§19.7)
#     소거법 금지(C-2)와 반증 우선은 이미 있다. 여기서는 그 위의 요건을 채운다.
#       §19.5.1   발화부의 발열 기기는 쉽게 배제되더라도 반드시 목록에 올린다
#       §19.6.3   가설 검증에서 답해야 할 질문 넷
#       §19.6.5.1 둘 이상이 기각되지 않아도 원인미상이다
#       §19.6.5.2 발화원과 최초 착화물을 짚은 것만으로는 원인이 아니다
# ============================================================================
efi:HeatProducingDevice a owl:Class ; rdfs:subClassOf efi:PhysicalEvidence ;
    rdfs:label "발열 기기"@ko ; skos:prefLabel "발열 기기"@ko ;
    rdfs:comment "발열하거나 고장 시 발열할 수 있는 기기. 쉽게 배제되더라도 가설 목록에 올린다 (§19.5.1)"@ko .
efi:NonRecoverableIgnitionSource a owl:Class ; rdfs:subClassOf efi:PhysicalEvidence ;
    rdfs:label "회수 불가 발화원"@ko ; skos:prefLabel "회수 불가 발화원"@ko ;
    rdfs:comment "라이터·정전기·낙뢰처럼 현장에 물체가 남지 않는 발화원. 존재·부재를 다른 증거로 세워야 한다 (§19.5.2)"@ko .

efi:atOriginArea a owl:DatatypeProperty ; rdfs:domain efi:PhysicalEvidence ; rdfs:range xsd:boolean ;
    rdfs:label "발화 구역 내 존재"@ko ; skos:prefLabel "발화 구역 내 존재"@ko .
efi:hasCandidateSource a owl:ObjectProperty ; rdfs:domain efi:InvestigationSession ; rdfs:range efi:PhysicalEvidence ;
    rdfs:label "가설 목록에 올린 발화원 후보"@ko ; skos:prefLabel "가설 목록에 올린 발화원 후보"@ko .
efi:sourceCompetentForFuel a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "착화 역량 판단(질문 1)"@ko ; skos:prefLabel "착화 역량 판단(질문 1)"@ko ;
    rdfs:comment "가정한 발화원이 최초 착화물에 대해 경합 가능한 발화원인가 (§19.6.3(1))"@ko .
efi:timelineConsistent a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "시간선 정합(질문 2)"@ko ; skos:prefLabel "시간선 정합(질문 2)"@ko ;
    rdfs:comment "착화에 필요한 시간이 사건 시간선과 맞는가 (§19.6.3(2))"@ko .
efi:contactCircumstance a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:string ;
    rdfs:label "접촉 정황(질문 3)"@ko ; skos:prefLabel "접촉 정황(질문 3)"@ko ;
    rdfs:comment "발화원과 최초 착화물을 접촉시킨 정황 (§19.6.3(3))"@ko .

# [C-28] 가설 검증에서 답해야 할 질문에 답하지 않은 채 결론을 낼 수 없다 (§19.6.3).
#  질문 4(고장 모드)는 '있다면'이라 필수가 아니다.
efi:TestingQuestionsShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §19.6.3 Hypotheses Testing Questions" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "착화 역량·시간선·접촉 정황 중 답하지 않은 질문이 있다 (§19.6.3)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          FILTER ( NOT EXISTS { ?sc efi:sourceCompetentForFuel ?a }
                || NOT EXISTS { ?sc efi:timelineConsistent ?b }
                || NOT EXISTS { ?sc efi:contactCircumstance ?c } )
        }""" ] .

# [C-29] 발화부의 발열 기기는 쉽게 배제되더라도 반드시 가설 목록에 올린다 (§19.5.1).
#  뻔해 보인다는 이유로 목록에서 빠지면 그 가설은 시험조차 되지 않는다.
efi:HeatProducingDeviceListedShape a sh:NodeShape ; sh:targetClass efi:InvestigationSession ;
    dcterms:references "NFPA 921 (2024) §19.5.1 Developing Cause Hypotheses" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "발화 구역의 발열 기기가 가설 목록에 없다. 쉽게 배제되더라도 목록에는 올려야 한다 (§19.5.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:hasFact ?d .
          ?d rdf:type/rdfs:subClassOf* efi:HeatProducingDevice ; efi:atOriginArea true .
          FILTER NOT EXISTS { $this efi:hasCandidateSource ?d }
        }""" ] .

# [C-30] 발화원과 최초 착화물을 짚은 것만으로는 원인이 아니다 (§19.6.5.2).
#  둘을 한자리에 모은 정황이 있어야 원인이 된다.
efi:CauseNotJustSourceShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §19.6.5.2 Ignition Source vs Fire Cause" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "발화원과 착화물을 짚었을 뿐 둘을 모은 정황이 없다. 그것만으로는 원인이 아니다 (§19.6.5.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          FILTER NOT EXISTS { ?sc efi:hasAntecedent ?a }
        }""" ] .

# [C-31] 착화 역량이 미달인 가설로 결론을 낼 수 없다 (§19.6.4.2·§19.6.5.2).
#  물리 법칙에 어긋나는 가설은 반증된 것이다.
efi:CompetenceRequiredShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §19.6.4.2 Fundamental Principles of Science" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "도달 온도가 발화 온도에 못 미치는 가설로 결론을 낼 수 없다 (§19.6.4.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:ignitionCompetenceGap true .
        }""" ] .

# [D-8] 둘 이상이 기각되지 않아도 원인미상이다 (§19.6.5.1).
#  D-7 은 모두 기각된 경우만 잡았다. 원문은 그 반대 경우도 원인미상이라고 한다.
efi:UndeterminedByTieRuleShape a sh:NodeShape ; sh:targetClass efi:InvestigationSession ;
    dcterms:references "NFPA 921 (2024) §19.6.5.1 Cause Undetermined" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 5 ;
        sh:construct """
        CONSTRUCT { $this efi:outcomeUndetermined true . }
        WHERE {
          ?h1 efi:inSession $this ; efi:supportScore ?n1 .
          ?h2 efi:inSession $this ; efi:supportScore ?n2 .
          FILTER ( ?h1 != ?h2 && ?n1 = ?n2 )
          FILTER NOT EXISTS { ?h1 efi:verdict efi:Refuted }
          FILTER NOT EXISTS { ?h2 efi:verdict efi:Refuted }
        }""" ] .

# ============================================================================
# 20. 전기 에너지에 의한 발화 (NFPA 921 §9.9)
# ============================================================================

# §9.9.4.5 정정 — 탄화는 통전으로만 생기지 않는다. 열에 의한 비전기적 탄화가 있고
#  화재 자체가 그 열원이 될 수 있다. 탄화 도전로를 트래킹 전용 단서로 두었던 것은
#  과대평가였다. 외부화염도 낼 수 있는 양상으로 정정한다.
efi:ExternalFlameExposure efi:producesDamage efi:CarbonizedConductivePath .
efi:ExternalFlameScenario efi:canManifest efi:CarbonizedConductivePath .

efi:heatTransferPath a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:string ;
    rdfs:label "열전달 경로"@ko ; skos:prefLabel "열전달 경로"@ko ;
    rdfs:comment "발열원과 최초 착화물 사이의 열 전달 경로 또는 방법. 식별되지 않으면 전기적 원인으로 확정할 수 없다 (§9.9.1.4)"@ko .
efi:arcInitiationMode a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:string ;
    rdfs:label "아크 개시 경위"@ko ; skos:prefLabel "아크 개시 경위"@ko ;
    rdfs:comment "공기 중 자발 아크에는 최소 350 V 가 필요하다. 120/240 V 계통에서는 자발적으로 생기지 않으므로 어떻게 시작됐는지 밝혀야 한다 (§9.9.4.1)"@ko .
efi:conductorSizeReducedAfterProtection a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "보호장치 하류 도체 축소"@ko ; skos:prefLabel "보호장치 하류 도체 축소"@ko ;
    rdfs:comment "연장선처럼 보호장치와 부하 사이에 더 가는 도체가 있으면 보호장치를 동작시키지 않고 과열될 수 있다 (§9.9.3.2)"@ko .

# [C-32] 전기적 원인으로 확정하려면 발열원과 최초 착화물 사이의
#  열전달 경로가 식별돼야 한다 (§9.9.1.4).
efi:HeatTransferPathShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.9.1.4 Ignition by Electrical Energy" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "발열원과 최초 착화물 사이의 열전달 경로가 식별되지 않았다. 전기적 원인으로 확정할 수 없다 (§9.9.1.4)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          ?m rdf:type/rdfs:subClassOf* efi:ElectricalHeatingMechanism .
          FILTER NOT EXISTS { ?sc efi:heatTransferPath ?p }
        }""" ] .

# [C-33] 120/240 V 계통에서 아크는 자발적으로 생기지 않는다 (§9.9.4.1).
#  아크 가설은 아크가 어떻게 시작됐는지를 밝혀야 한다.
efi:ArcInitiationShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §9.9.4.1 Arcs" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "아크가 어떻게 시작됐는지 밝히지 않았다. 저전압 계통에서 아크는 자발적으로 생기지 않는다 (§9.9.4.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          ?m rdf:type/rdfs:subClassOf* efi:ArcHeating .
          FILTER NOT EXISTS { ?sc efi:arcInitiationMode ?k }
        }""" ] .

# [C-34] 과부하 발화는 도체 규격이 적정한 회로에서는 드물다 (§9.9.3.2).
#  보호장치가 먼저 열려 발화 조건에 이르기 전에 발열이 멈추기 때문이다.
#  과부하 발화를 주장하려면 보호장치 미동작이거나 하류 도체 축소가 있어야 한다.
efi:OverloadIgnitionRarityShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.9.3.2 Overcurrent and Overload" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "과부하 발화는 보호가 정상이면 드물다. 보호장치 미동작 또는 하류 도체 축소를 밝혀야 한다 (§9.9.3.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          ?m rdf:type/rdfs:subClassOf* efi:OverloadHeating .
          FILTER NOT EXISTS { ?sc efi:conductorSizeReducedAfterProtection true }
          FILTER NOT EXISTS {
            ?sc efi:hasAntecedent ?a .
            ?a rdf:type/rdfs:subClassOf* efi:HeatDissipationImpairment .
          }
        }""" ] .

# ============================================================================
# 21. 방열 저해 조건 (NFPA 921 §9.9.1.2 · §9.9.2.2 · §9.9.3.2)
#     원문의 물리 논의(와트·온도·지속 시간)는 가설을 시험할 때 참조하는 지식이지
#     현장에서 관측하는 대상이 아니다. 관측 가능한 형태는 '열이 빠져나가지 못하는
#     상태였는가'이고, 그것만 담는다.
#     같은 전류가 흘러도 방열이 막히면 발화하고 아니면 하지 않는다.
# ============================================================================
efi:HeatDissipationImpairment a owl:Class ; rdfs:subClassOf efi:AntecedentCondition ;
    rdfs:label "방열 저해 조건"@ko ; skos:prefLabel "방열 저해 조건"@ko ;
    rdfs:comment "발생한 열이 주위로 빠져나가지 못하는 상태. 정격 전류에서도 발화 조건에 이를 수 있다 (§9.9.2.2)"@ko .
efi:ThermalInsulationEnclosure a owl:Class ; rdfs:subClassOf efi:HeatDissipationImpairment ;
    rdfs:label "단열재 매입·포설"@ko ; skos:prefLabel "단열재 매입·포설"@ko .
efi:BundledWiring a owl:Class ; rdfs:subClassOf efi:HeatDissipationImpairment ;
    rdfs:label "다발 배선"@ko ; skos:prefLabel "다발 배선"@ko ;
    rdfs:comment "케이블이 다발로 묶여 서로의 열을 가둔다 (§9.9.3.2)"@ko .
efi:CoveredHeatingDevice a owl:Class ; rdfs:subClassOf efi:HeatDissipationImpairment ;
    rdfs:label "발열체 적치·접힘"@ko ; skos:prefLabel "발열체 적치·접힘"@ko ;
    rdfs:comment "전기요를 접거나 발열체 위에 물건을 덮으면 열이 좁은 곳에 갇힌다 (§9.9.1.2)"@ko .

efi:ThermalInsulationTrace a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "단열재 매입 흔적"@ko ; skos:prefLabel "단열재 매입 흔적"@ko .
efi:BundledWiringTrace a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "다발 배선 흔적"@ko ; skos:prefLabel "다발 배선 흔적"@ko .

efi:ThermalInsulationTrace efi:attests efi:ThermalInsulationEnclosure .
efi:BundledWiringTrace efi:attests efi:BundledWiring .
efi:HeatDissipationImpairment efi:enables efi:ResistiveHeating , efi:OverloadHeating .

# [C-35] 전기적 원인 결론에는 최초 착화물이 발열원에서 얼마나 떨어져 있었는지가
#  기록돼야 한다 (§9.9.1.1 — 착화되는 것은 '가까이 있는' 재료다).
#  거리 임계값은 정하지 않는다. 원문이 수치를 주지 않았고 재료마다 다르다.
efi:FuelProximityShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §9.9.1.1 Ignition by Electrical Energy" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "최초 착화물이 발열원에서 얼마나 떨어져 있었는지 기록되지 않았다 (§9.9.1.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m ; efi:hasFirstFuel ?f .
          ?m rdf:type/rdfs:subClassOf* efi:ElectricalHeatingMechanism .
          FILTER NOT EXISTS { ?f efi:distanceToHeatSource_mm ?d }
        }""" ] .

# ============================================================================
# 22. 아크의 연료별 착화 역량 (NFPA 921 §9.9.4.1 · §9.9.4.4)
#     아크 경로 안의 온도는 수천 도지만, 짧고 국부적이라 많은 연료를 착화시키지
#     못한다. 목재 구조재 같은 벌크 고체는 통상 착화되지 않고, 표면적/질량비가
#     큰 연료와 가스·증기·분진만 붙는다. F-3 은 온도만 보므로 이 축이 따로 필요하다.
# ============================================================================
efi:ignitableByBriefArc a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "짧은 아크로 착화 가능"@ko ; skos:prefLabel "짧은 아크로 착화 가능"@ko ;
    rdfs:comment "통상적인 배선 아크는 짧고 저에너지다. 이 값이 거짓인 연료는 아크 단독으로 착화되지 않는다 (§9.9.4.4)"@ko .

efi:FlammableVaporFuel efi:ignitableByBriefArc true .
efi:AccumulatedDustFuel efi:ignitableByBriefArc true .
efi:PaperTextileFuel efi:ignitableByBriefArc true .
efi:WoodStructuralFuel efi:ignitableByBriefArc false .

# [C-36] 짧은 아크로 착화되지 않는 연료를 아크 가설의 최초 착화물로 둘 수 없다.
#  트래킹은 제외한다 — 표면에서 지속되는 아크라 성격이 다르다 (§9.9.4.5.1).
efi:ArcFuelCompetenceShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.9.4.1 Arcs" ,
                       "NFPA 921 (2024) §9.9.4.4 Parting Arcs" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "짧고 국부적인 아크로는 이 연료가 착화되지 않는다. 착화 역량이 성립하지 않는다 (§9.9.4.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m ; efi:hasFirstFuel ?f .
          { ?m rdf:type/rdfs:subClassOf* efi:ShortCircuitArc }
          UNION
          { ?m rdf:type/rdfs:subClassOf* efi:SeriesArc }
          ?f rdf:type/rdfs:subClassOf* ?FA .
          ?FA efi:ignitableByBriefArc false .
        }""" ] .

# ============================================================================
# 23. 전기 계통 손상 해석 (NFPA 921 §9.10 · §9.11)
# ============================================================================

# §9.10.2 정정 — 화재 열로 탄화된 피복을 통한 아크는 여러 지점에서 일어난다.
#  다발성 아크 비드를 반단선 전용 단서로 둔 것은 과대평가였다.
#  §9.9.4.5 의 탄화 정정과 같은 뿌리다.
efi:ExternalFlameExposure efi:producesDamage efi:MultipleArcBeads .
efi:ExternalFlameScenario efi:canManifest efi:MultipleArcBeads .

# §9.10.4.1 과부하의 형태 지표
efi:Sleeving a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "슬리빙(피복 연화·처짐)"@ko ; skos:prefLabel "슬리빙(피복 연화·처짐)"@ko ;
    rdfs:comment "과부하 구간 전 길이에 걸친 내부 발열로 열가소성 피복이 연화·처진다 (§9.10.4.1)"@ko .
efi:MeltOffset a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "용융 오프셋"@ko ; skos:prefLabel "용융 오프셋"@ko ;
    rdfs:comment "도체가 끊겨 회로가 열리는 순간 다른 용융 시작 지점이 굳어 어긋난 형태로 남는다. 대과부하의 지표 (§9.10.4.1)"@ko .
efi:OverloadHeating efi:producesDamage efi:Sleeving , efi:MeltOffset .

# §9.10.3.3 발광 접속부의 고유 증거. 원문이 외부 화재 노출로 인한 용융·아크와
#  외관상 구별된다고 명시한 것들이다.
efi:MoltenOxideMass a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "용융 산화물 덩어리"@ko ; skos:prefLabel "용융 산화물 덩어리"@ko ;
    rdfs:comment "강제 단자 둘레에서 구리 도체가 산화물 덩어리로 변한 것 (§9.10.3.3)"@ko .
efi:EnlargedScrewHeadOxidation a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "나사머리 비대 산화"@ko ; skos:prefLabel "나사머리 비대 산화"@ko ;
    rdfs:comment "고온 산화로 나사머리가 부풀어 오른 것 (§9.10.3.3)"@ko .
efi:OxideBanding a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "산화물 표면 밴딩"@ko ; skos:prefLabel "산화물 표면 밴딩"@ko ;
    rdfs:comment "용융 산화물 표면의 띠·물결 무늬. 필라멘트가 여러 시간에 걸쳐 자리를 옮긴 흔적 (§9.10.3.1(12))"@ko .
efi:GlowingConnection efi:producesDamage efi:MoltenOxideMass , efi:EnlargedScrewHeadOxidation , efi:OxideBanding .
efi:PoorContactScenario efi:canManifest efi:MoltenOxideMass , efi:EnlargedScrewHeadOxidation , efi:OxideBanding .
efi:ConnectionPoint efi:exhibits efi:MoltenOxideMass , efi:EnlargedScrewHeadOxidation , efi:OxideBanding .

# §9.10.5 기계적 홈·눌림. 아크흔과 구별된다 — 긁힘 자국과 변형이 있고 융착면이 없다.
efi:MechanicalGouge a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "기계적 홈·눌림"@ko ; skos:prefLabel "기계적 홈·눌림"@ko ;
    rdfs:comment "긁힘 자국과 하부 변형이 있고 전기 에너지가 만드는 융착면이 없다. 아크흔과 구별된다 (§9.10.5)"@ko .
efi:Conductor efi:exhibits efi:MechanicalGouge .

# §9.10.6.1 설치 시 망치 오타격. 눈에 잘 띄지 않는 피복 손상을 남기고
#  한참 뒤 서지에서 절연 파괴로 이어질 수 있다.
efi:HammerMisHitDamage a owl:Class ; rdfs:subClassOf efi:MechanicalStressHistory ;
    rdfs:label "설치 시 망치 오타격 손상"@ko ; skos:prefLabel "설치 시 망치 오타격 손상"@ko ;
    rdfs:comment "피복의 절연 내력을 낮춰 예상 서지 전압에서 아크가 생길 수 있다. 설치 후 오랜 시간이 지나 발생하기도 한다 (§9.10.6.1)"@ko .
efi:HammerMisHitDamage efi:enables efi:InsulationBreakdownArc .

# ── 원문이 명시적으로 부정하는 통념 ──────────────────────────────────────
# [C-37] 언더사이즈 도체나 과대 보호기는 화재 원인의 증거가 아니다 (§9.11.1).
#  허용 전류에는 큰 안전율이 있고, 추가 발열만으로 피복이 벗겨지지 않는다.
efi:UndersizedConductorFuel a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "언더사이즈 도체·과대 보호기"@ko ; skos:prefLabel "언더사이즈 도체·과대 보호기"@ko .
efi:NickedOrStretchedConductor a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "니크·연신 도체"@ko ; skos:prefLabel "니크·연신 도체"@ko .

efi:MisconceptionShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.11.1 Undersized Conductors" ,
                       "NFPA 921 (2024) §9.11.2 Nicked or Stretched Conductors" ,
                       "NFPA 921 (2024) §9.10.4.1 Overload" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "언더사이즈 도체·과대 보호기는 화재 원인의 증거가 아니다. 허용 전류에는 큰 안전율이 있다 (§9.11.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:supportedBy ?f .
          ?f rdf:type/rdfs:subClassOf* efi:UndersizedConductorFuel .
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "니크·연신에 의한 단면 감소는 발열 근거가 되지 못한다. 추가 발열은 무시할 수준이다 (§9.11.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:supportedBy ?f .
          ?f rdf:type/rdfs:subClassOf* efi:NickedOrStretchedConductor .
        }""" ] .

# [C-38] 과전류 용융의 증거는 그 방식에 의한 발화의 증거가 아니다 (§9.10.4.1).
#  아크 용융흔에 대한 C-8 과 같은 형태의 경고다.
efi:OverloadMeltingNotProofShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.10.4.1 Overload" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "과전류 용융 흔적만으로는 그 방식에 의한 발화를 증명하지 못한다 (§9.10.4.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          ?m rdf:type/rdfs:subClassOf* efi:OverloadHeating .
          FILTER EXISTS { ?sc efi:supportedBy ?f . ?f rdf:type/rdfs:subClassOf* efi:MeltOffset }
          FILTER NOT EXISTS {
            ?sc efi:supportedBy ?g .
            ?g efi:confirmationStatus efi:Confirmed .
            FILTER NOT EXISTS { ?g rdf:type/rdfs:subClassOf* efi:DamagePattern }
          }
        }""" ] .

# [C-39] 버스바 아크는 전원 반대쪽으로 이동한다. 손상이 가장 큰 곳이
#  발생 지점이 아닐 수 있다 (§9.10.2.2).
efi:BusBar a owl:Class ; rdfs:subClassOf efi:Conductor ;
    rdfs:label "버스바"@ko ; skos:prefLabel "버스바"@ko ;
    rdfs:comment "아크가 전원 반대 방향으로 이동해, 아크가 끝난 자리의 손상이 발생 지점보다 클 수 있다 (§9.10.2.2)"@ko .
efi:arcTravelConsidered a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "아크 이동 고려 여부"@ko ; skos:prefLabel "아크 이동 고려 여부"@ko .

efi:BusBarArcTravelShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.10.2.2 Arcing Through a Carbonized Path" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "버스바에서는 아크가 이동한다. 손상이 큰 자리를 발생 지점으로 볼 수 없으므로 이동을 고려했는지 밝혀야 한다 (§9.10.2.2)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:inSession ?s .
          ?s efi:hasFact ?b .
          ?b rdf:type/rdfs:subClassOf* efi:BusBar .
          FILTER NOT EXISTS { ?sc efi:arcTravelConsidered true }
        }""" ] .

# ── 형태 발현 편향 점검 결과 반영 (scripts/audit.py) ─────────────────────
#  '이 가설이 이 흔적을 낸다'만 담고 '화재 자체가 낸다'를 빠뜨린 선언들이다.
#  §9.10.1  화재로 연화된 피복이 단락 파팅 아크를 만든다 → 아크흔·비드
#  §9.10.3.1(1) 화재 노출만으로도 금속이 산화된다 → 변색·광택 소실
efi:ExternalFlameExposure efi:producesDamage
    efi:ArcMeltMark , efi:ArcBead , efi:LocalizedDiscoloration , efi:LossOfLuster .
efi:ExternalFlameScenario efi:canManifest
    efi:ArcMeltMark , efi:ArcBead , efi:LocalizedDiscoloration , efi:LossOfLuster .

# ============================================================================
# 24. 손상 도체 식별의 통념들 (NFPA 921 §9.11.3~§9.11.6)
#     원문이 "…라고 여겨져 왔으나" 로 시작해 부정하는 대목들이다.
#     반증 근거는 지어내기 어려운데 원문이 직접 준다.
# ============================================================================
efi:CrackedInsulation a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "피복 균열"@ko ; skos:prefLabel "피복 균열"@ko ;
    rdfs:comment "취화로 갈라진 균열. 도전성 용액이 들어가지 않는 한 누설 전류가 흐르지 않는다 (§9.11.3)"@ko .
efi:ConductiveSolutionInCrack a owl:Class ; rdfs:subClassOf efi:EnvironmentalCondition ;
    rdfs:label "균열 내 도전성 용액"@ko ; skos:prefLabel "균열 내 도전성 용액"@ko ;
    rdfs:comment "균열이 누설 경로가 되려면 이것이 있어야 한다 (§9.11.3)"@ko .
efi:MisdrivenStaple a owl:Class ; rdfs:subClassOf efi:MechanicalStressHistory ;
    rdfs:label "스테이플 오타입"@ko ; skos:prefLabel "스테이플 오타입"@ko ;
    rdfs:comment "피복을 눌러 수개월~수년 뒤 고저항 접촉을 만들 수 있다 (§9.11.4.3)"@ko .
efi:MetalTransferToFastener a owl:Class ; rdfs:subClassOf efi:DamagePattern ;
    rdfs:label "못·스테이플로의 금속 전이"@ko ; skos:prefLabel "못·스테이플로의 금속 전이"@ko ;
    rdfs:comment "진행 중인 화재의 결과일 수 있다. 고저항 경로의 증거로 단정할 수 없다 (§9.11.4.3)"@ko .
efi:ExternalFlameExposure efi:producesDamage efi:MetalTransferToFastener , efi:CrackedInsulation .
efi:MisdrivenStaple efi:enables efi:PoorContactHeating .

# [C-40] 피복 균열만으로 누설 경로를 주장할 수 없다 (§9.11.3).
#  도전성 용액이 균열에 들어가야 누설 전류가 흐른다.
efi:CrackedInsulationLeakageShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.11.3 Deteriorated Insulation" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "피복 균열만으로는 누설 전류가 흐르지 않는다. 도전성 용액이 균열에 들어갔음을 밝혀야 한다 (§9.11.3)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m .
          ?m rdf:type/rdfs:subClassOf* efi:LeakageCurrentHeating .
          FILTER EXISTS { ?sc efi:supportedBy ?f . ?f rdf:type/rdfs:subClassOf* efi:CrackedInsulation }
          FILTER NOT EXISTS {
            ?sc efi:hasAntecedent ?a .
            ?a rdf:type/rdfs:subClassOf* efi:ConductiveSolutionInCrack .
          }
        }""" ] .

# [C-41] 분기회로의 단락은 통상 피복을 착화시키지 않는다 (§9.11.5).
#  보호장치 동작 전의 짧은 섬광은 발화성 증기를 낼 만큼 피복을 데우지 못한다.
#  보호가 무력화·고장 난 경우에만 과부하가 되어 발화원이 될 수 있다.
efi:ShortCircuitIgnitionShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §9.11.5 Short Circuit" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "분기회로 단락은 통상 피복을 착화시키지 못한다. 보호장치가 무력화·고장 났음을 밝혀야 한다 (§9.11.5)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:hasMechanism ?m ; efi:hasFirstFuel ?f .
          ?m rdf:type/rdfs:subClassOf* efi:ShortCircuitArc .
          ?f rdf:type/rdfs:subClassOf* efi:InsulationMaterialFuel .
          FILTER NOT EXISTS { ?sc efi:conductorSizeReducedAfterProtection true }
          FILTER NOT EXISTS { ?sc efi:hasAntecedent ?a . ?a rdf:type/rdfs:subClassOf* efi:HeatDissipationImpairment }
        }""" ] .

# ============================================================================
# 25. 전기 계통 검사 (NFPA 921 §9.12)
#     대부분 현장 작업 절차다(안전 확보·LOTO·촬영). 온톨로지가 담을 것은
#     검사 범위가 관심 영역에 전원을 공급하는 계통 전체를 포함했는가이다.
# ============================================================================
efi:examinationCoversSupplyPath a owl:DatatypeProperty ; rdfs:domain efi:ArcSurvey ; rdfs:range xsd:boolean ;
    rdfs:label "공급 경로 전체 검사"@ko ; skos:prefLabel "공급 경로 전체 검사"@ko ;
    rdfs:comment "관심 영역에 전원을 공급하는 계통의 모든 관련 구성요소를 식별·검사했는가 (§9.12.4)"@ko .

# [C-43] 검사 범위가 공급 경로 전체를 포함했는지 밝혀야 한다 (§9.12.4).
efi:SupplyPathCoverageShape a sh:NodeShape ; sh:targetClass efi:ArcSurvey ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §9.12.4 Systematic Approach" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "관심 영역에 전원을 공급하는 계통 전체를 검사했는지 밝혀야 한다 (§9.12.4)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:surveyComplete true .
          FILTER NOT EXISTS { $this efi:examinationCoversSupplyPath true }
        }""" ] .

# §9.11.3 일관 적용 — 절연은 노후와 가열로 취화된다. 화재 열도 가열이다.
#  새로 만든 CrackedInsulation 에만 적용하고 기존 InsulationEmbrittlement 를
#  빼두면 점수를 지키려고 일관성을 깨는 것이 된다. 그게 고치려는 편향이다.
efi:ExternalFlameExposure efi:producesDamage efi:InsulationEmbrittlement .
efi:ExternalFlameScenario efi:canManifest efi:InsulationEmbrittlement , efi:CrackedInsulation .

# ============================================================================
# 26. 발화 순서 기여 요인 (NFPA 921 §19.4.4.2.1)
#     발화 순서 설명에 반드시 포함돼야 할 일곱 가지. 원문이 열거해 준 체크리스트라
#     지어낼 것이 없다. 어느 하나라도 답하지 않으면 발화 순서를 설명한 것이 아니다.
# ============================================================================
efi:IgnitionSequenceFactor a owl:Class ; rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "발화 순서 기여 요인"@ko ; skos:prefLabel "발화 순서 기여 요인"@ko .

efi:FactorFuelPresence a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "최초 착화물이 착화 가능한 형태·상·형상으로 있게 된 경위"@ko .
efi:FactorOxidantPresence a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "산화제가 적절한 형태·양으로 있게 된 경위"@ko .
efi:FactorSourcePresence a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "경합 발화원이 존재하고 연료와 만나게 된 경위"@ko .
efi:FactorHeatTransfer a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "발화원이 열에너지를 연료로 전달한 경위"@ko .
efi:FactorSafetyDevice a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "안전장치가 작동했는지 실패했는지"@ko .
efi:FactorBringingTogether a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "행위·부작위·외부 요인이 셋을 한자리 한시점에 모은 경위"@ko .
efi:FactorFireSpread a owl:NamedIndividual , efi:IgnitionSequenceFactor ;
    skos:prefLabel "2차·3차 연료로 확산된 경위와 전파 경로"@ko .

efi:addressesFactor a owl:ObjectProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:IgnitionSequenceFactor ;
    rdfs:label "설명한 발화 순서 요인"@ko ; skos:prefLabel "설명한 발화 순서 요인"@ko .

# [C-44] 일곱 요인을 모두 설명하지 않으면 발화 순서를 설명한 것이 아니다 (§19.4.4.2.1).
efi:IgnitionSequenceShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §19.4.4.2.1 Analyzing the Ignition Sequence" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "발화 순서 기여 요인 일곱 중 설명하지 않은 것이 있다 (§19.4.4.2.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?f a efi:IgnitionSequenceFactor .
          FILTER NOT EXISTS { ?sc efi:addressesFactor ?f }
        }""" ] .

# ============================================================================
# 27. 발화원 미발견 시 추론 (NFPA 921 §19.4.4.3)
#     원인 판정은 증거에 근거해야지 증거의 부재에 근거해서는 안 된다. 다만 발화원을
#     찾지 못했어도 발화 순서를 논리적으로 추론할 수 있는 제한적 상황이 있다.
#     그 상황에 해당하지 않으면 추론해서는 안 된다.
# ============================================================================
efi:InferenceWarrant a owl:Class ; rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "발화원 미발견 추론 근거"@ko ; skos:prefLabel "발화원 미발견 추론 근거"@ko .
efi:WarrantDiffuseFuelExplosion a owl:NamedIndividual , efi:InferenceWarrant ;
    skos:prefLabel "확산 연료 폭발·순간 화염"@ko .
efi:WarrantIgnitibleLiquidResidue a owl:NamedIndividual , efi:InferenceWarrant ;
    skos:prefLabel "실험실 확인된 인화성 액체 잔류물에 정상적 설명이 없음"@ko .
efi:WarrantMultipleFires a owl:NamedIndividual , efi:InferenceWarrant ;
    skos:prefLabel "복수 발화 지점"@ko .
efi:WarrantTrailers a owl:NamedIndividual , efi:InferenceWarrant ;
    skos:prefLabel "트레일러(연소 유도선) 관찰"@ko .
efi:WarrantObservedInception a owl:NamedIndividual , efi:InferenceWarrant ;
    skos:prefLabel "발생 시점 또는 2차 연료 확산 이전에 관찰·기록됨"@ko .

efi:sourceNotRecovered a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "발화원 미회수"@ko ; skos:prefLabel "발화원 미회수"@ko .
efi:hasInferenceWarrant a owl:ObjectProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range efi:InferenceWarrant ;
    rdfs:label "추론 근거"@ko ; skos:prefLabel "추론 근거"@ko .

# [C-45] 발화원을 찾지 못한 채 원인을 말하려면 원문이 든 제한적 상황에
#  해당해야 한다 (§19.4.4.3). 목록은 배타적이지 않으나, 근거 없이 발화 순서를
#  가정하는 것을 원문이 경계한다.
efi:UnrecoveredSourceShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    dcterms:references "NFPA 921 (2024) §19.4.4.3 Analyzing the Ignition Sequence" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "발화원을 회수하지 못했는데 추론을 뒷받침하는 근거가 없다. 원인 판정은 증거의 부재가 아니라 증거에 근거해야 한다 (§19.4.4.3)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:sourceNotRecovered true .
          FILTER NOT EXISTS { ?sc efi:hasInferenceWarrant ?w }
        }""" ] .

# [C-46] 복수의 경합 발화원 중 어느 것인지 특정하지 못해도 가설은 설 수 있다.
#  다만 특정하지 못했다는 사실이 드러나야 한다 (§19.5.4).
efi:sourceUnspecified a owl:DatatypeProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range xsd:boolean ;
    rdfs:label "경합 발화원 미특정"@ko ; skos:prefLabel "경합 발화원 미특정"@ko ;
    rdfs:comment "발화부에 경합 발화원이 여럿이고 어느 것이 착화시켰는지 판정할 수 없는 상태 (§19.5.4)"@ko .
efi:UnspecifiedSourceDisclosureShape a sh:NodeShape ; sh:targetClass efi:Conclusion ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §19.5.4 Developing Cause Hypotheses" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "경합 발화원을 특정하지 못했다면 그 사실을 한계로 명시해야 한다 (§19.5.4)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:concludes ?sc .
          ?sc efi:sourceUnspecified true .
          FILTER NOT EXISTS { $this efi:statedLimitation ?l }
        }""" ] .

# ============================================================================
# 28. 확증 편향과 가설 검증 수단 (NFPA 921 §4.3.10 · §4.6.2.1 · §19.6.4)
# ============================================================================
# [M-4] 같은 자료가 대안 가설도 지지한다 (§4.3.10).
#  M-2 는 손상 양상만 본다. 원문은 형태에 한정하지 않으므로 선행 조건까지 넓힌다.
#  선행 조건을 공유하는 가설 쌍은 그 조건으로는 갈리지 않는다.
efi:evidentiallyAmbiguousWith a owl:ObjectProperty ;
    rdfs:domain efi:IgnitionScenario ; rdfs:range efi:IgnitionScenario ;
    rdfs:label "증거상 혼동 가설"@ko ; skos:prefLabel "증거상 혼동 가설"@ko ;
    rdfs:comment "선행 조건을 공유해 그 조건만으로는 갈리지 않는 가설 쌍 (§4.3.10)"@ko .

efi:EvidentialAmbiguityRuleShape a sh:NodeShape ; sh:targetSubjectsOf efi:hasDeclaredMechanism ;
    dcterms:references "NFPA 921 (2024) §4.3.10 Confirmation Bias" ;
    sh:rule [ a sh:SPARQLRule ; sh:prefixes <https://w3id.org/efi-onto> ; sh:order 0 ;
        sh:construct """
        CONSTRUCT { $this efi:evidentiallyAmbiguousWith ?o . }
        WHERE {
          $this efi:hasDeclaredMechanism ?m1 .
          ?a efi:enables ?m1 .
          ?o efi:hasDeclaredMechanism ?m2 .
          ?a efi:enables ?m2 .
          FILTER ( $this != ?o )
        }""" ] .

# 가설 검증 수단 (§19.6.4). 원문이 든 것들이다.
efi:HypothesisTestMethod a owl:Class ; rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "가설 검증 수단"@ko ; skos:prefLabel "가설 검증 수단"@ko .
efi:TestByScientificLiterature a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "과학 문헌"@ko ; rdfs:comment "의존한 연구는 인용해 밝혀야 한다 (§19.6.4.1)"@ko .
efi:TestByScientificPrinciple a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "과학 원리 적용"@ko ; rdfs:comment "물리·열역학 법칙에 어긋나면 반증된 것이다 (§19.6.4.2)"@ko .
efi:TestByPhysicalExperiment a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "물리 실험"@ko .
efi:TestByCognitiveExperiment a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "인지 실험"@ko .
efi:TestByTimeline a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "시간선 대조"@ko .
efi:TestByFaultTree a owl:NamedIndividual , efi:HypothesisTestMethod ;
    skos:prefLabel "고장 수목"@ko ; rdfs:comment "조건이나 순서가 없으면 가설은 반증된다 (§19.6.4.6)"@ko .

efi:testedBy a owl:ObjectProperty ; rdfs:domain efi:IgnitionScenario ; rdfs:range efi:HypothesisTestMethod ;
    rdfs:label "검증 수단"@ko ; skos:prefLabel "검증 수단"@ko .

# [C-47] 문헌에 기대어 검증했다면 그 연구를 인용해 밝혀야 한다 (§19.6.4.1).
efi:LiteratureCitationShape a sh:NodeShape ; sh:targetClass efi:IgnitionScenario ;
    sh:severity sh:Warning ;   # 권고 — 원문이 should 로 쓴 요건
    dcterms:references "NFPA 921 (2024) §19.6.4.1 Scientific Literature" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <https://w3id.org/efi-onto> ;
        sh:message "문헌으로 가설을 검증했다면 의존한 연구를 인용해야 한다 (§19.6.4.1)"@ko ;
        sh:select """
        SELECT $this WHERE {
          $this efi:testedBy efi:TestByScientificLiterature .
          FILTER NOT EXISTS { $this <http://purl.org/dc/terms/references> ?r }
        }""" ] .

# [C-48] 기술 검토자는 결과에 이해관계가 있다고 비칠 수 있다 (§4.6.2.1).
#  확증 편향이 관계를 통해 들어온다. 관계를 밝히지 않은 기술 검토는 그 위험이 가려진다.
efi:reviewerRelationshipDisclosed a owl:DatatypeProperty ;
    rdfs:domain efi:WorkProductReview ; rdfs:range xsd:boolean ;
    rdfs:label "검토자 관계 공개"@ko ; skos:prefLabel "검토자 관계 공개"@ko .
efi:TechnicalReviewBiasShape a sh:NodeShape ; sh:targetClass efi:TechnicalReview ;
    dcterms:references "NFPA 921 (2024) §4.6.2.1 Limitations of Technical Reviews" ;
    sh:property [ sh:path efi:reviewerRelationshipDisclosed ; sh:minCount 1 ;
        # 권고 — §4.6.2.1 should strive to maintain detachment
        sh:severity sh:Warning ;
        sh:message "검토자와 조사자의 관계를 밝혀야 한다. 확증 편향은 관계를 통해 들어온다 (§4.6.2.1)"@ko ] .

# 편향 점검 2차 반영 — 화재도 내는 것으로 판정된 양상들
#  §9.9.5   스패터는 아크가 던진 입자다. §9.10.1 화재도 아크를 만든다.
#  §9.10.2  화재 탄화를 통한 아크가 도체를 여러 토막으로 끊는다.
efi:ExternalFlameExposure efi:producesDamage
    efi:Spatter , efi:StrandFracture , efi:SmallMeltBallOnStrandEnd .
efi:ExternalFlameScenario efi:canManifest
    efi:Spatter , efi:StrandFracture , efi:SmallMeltBallOnStrandEnd .

# ============================================================================
# 29. 구조 점검으로 드러난 끊긴 사슬 (scripts/lint.py)
#     선언만 하고 사슬에 붙이지 않은 어휘들이다. 확인해도 어떤 가설로도
#     이어지지 않으므로 판정에 기여하지 못한다.
# ============================================================================
# 발화 전 이상 징후 → 발열. 근거는 원문에 있다.
#  §9.10.3  접속이 헐거워지면 저항이 늘고 접점에서 발열이 커진다 → 온도·전압강하 이상
#  §9.5.2   중성선이 열리면 한쪽 다리가 과전압이 되어 조명이 지나치게 밝거나 어두워진다
efi:AbnormalTemperatureOrVoltageDrop efi:enables efi:PoorContactHeating , efi:ResistiveHeating , efi:PartialDisconnectionHeating .
efi:IntermittentRcdTripping efi:enables efi:LeakageCurrentHeating .
efi:FlickeringOrOdor efi:enables efi:PoorContactHeating , efi:OpenNeutralOvervoltage .

# §9.11.3 균열이 누설 경로가 되려면 도전성 용액이 들어가야 한다.
efi:ConductiveSolutionInCrack efi:enables efi:LeakageCurrentHeating , efi:ArcTracking .

# §9.13.4.7 아크 용융흔은 그 시점에 통전 중이었음을 증언한다.
efi:ArcMapPoint efi:attests efi:EnergizedState .

# 확장 슬롯 메커니즘에도 손상 양상을 붙인다. 흔적이 없으면 관측으로 확인할 길이 없다.
#  §9.5.2   과전압이 기기를 과열시킨다
#  §9.10.2.1 인입구 지속 고장은 수 피트에 걸쳐 도체를 부분 용융·소실시킨다
efi:OpenNeutralOvervoltage efi:producesDamage efi:InsulationCarbonization , efi:LocalizedDiscoloration .
efi:SustainedFaulting efi:producesDamage efi:LargeMeltMark , efi:ArcMeltMark , efi:Spatter .

# 연소 패턴은 발화 지점 특정에 쓰는 어휘다. 그 절차는 이 프로젝트 범위 밖이므로
# (설계계획서 1.1) 사슬에 붙이지 않는다. 범위가 넓어지면 그때 잇는다.
efi:BurnPattern rdfs:comment "발화 지점 특정용 어휘. 그 절차는 범위 밖이라 사슬에 붙이지 않는다"@ko .

# [C-49] 조사한 회로마다 보호장치 종류와 동작 상태를 기록한다 (§9.13.2.2).
efi:CircuitProtectionRecordShape a sh:NodeShape ; sh:targetClass efi:ArcSurvey ;
    dcterms:references "NFPA 921 (2024) §9.13.2.2 Arc Map" ;
    sh:property [ sh:path efi:circuitProtection ; sh:minCount 1 ;
        # 권고 — §9.13.2.2 should be recorded
        sh:severity sh:Warning ;
        sh:message "조사한 회로의 보호장치 종류와 상태를 기록해야 한다 (§9.13.2.2)"@ko ] .

# [C-50] 사건 분류는 어느 사건을 분류한 것인지 가리켜야 한다 (§19.8.1).
efi:IncidentClassificationTargetShape a sh:NodeShape ; sh:targetClass efi:IncidentClassification ;
    dcterms:references "NFPA 921 (2024) §19.8.1 Incident Classification for Statistical Purposes" ;
    sh:property [ sh:path efi:classifiesIncident ; sh:minCount 1 ;
        sh:message "어느 사건을 분류한 것인지 가리켜야 한다 (§19.8.1)"@ko ] .

# [C-51] 보고는 어느 의견을 담은 것인지 가리켜야 한다 (§4.7).
efi:ReportTargetShape a sh:NodeShape ; sh:targetClass efi:InvestigationReport ;
    dcterms:references "NFPA 921 (2024) §4.7 Reporting Procedure" ;
    sh:property [ sh:path efi:reportsConclusion ; sh:minCount 1 ;
        sh:message "보고가 어느 감별 의견을 담은 것인지 가리켜야 한다 (§4.7)"@ko ] .

# ============================================================================
# 30. 발화 전 아크·불꽃 목격
#     사례 실측에서 드러난 빈 곳이다. PreFireAnomaly 아래에 조명 깜박임·누전차단기
#     동작·온도 이상은 있었으나 '배선에서 불꽃을 봤다'가 없었다.
#
#     축은 현장 사실이다. 선행 조건이 아니라 관측이며, 통전 사실을 증언한다.
#     발화 전 아크를 목격했다면 그 시점에 회로가 살아 있었다는 뜻이다.
# ============================================================================
efi:PreFireArcObservation a owl:Class ; rdfs:subClassOf efi:SceneEvidence ;
    rdfs:label "발화 전 아크·불꽃 목격"@ko ; skos:prefLabel "발화 전 아크·불꽃 목격"@ko ;
    skos:altLabel "스파크 목격"@ko , "불꽃 발생 목격"@ko ;
    rdfs:comment "발화 이전 배선·기기에서 아크나 불꽃이 관찰·기록된 사실. 목격 진술과 영상 기록을 포함한다"@ko .
efi:PreFireArcObservation efi:attests efi:EnergizedState .

# 발화 전에 배선에서 아크가 있었다면 불이 밖에서 온 것이 아니다.
# 출처는 구조 유도다 — 외부화염 가설과 양립하지 않는다. NFPA 조항을 붙이지 않는다.
efi:R_EF_ref2 a efi:IndicatorRule ; efi:forScenario efi:ExternalFlameScenario ;
    efi:indicates efi:PreFireArcObservation ;
    efi:hasRole efi:Refuting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta -30 ;
    rdfs:comment "발화 전 배선 아크 목격 → 외부에서 옮겨붙은 화염이라는 가설과 양립하지 않는다"@ko .

# ============================================================================
# 31. 반단선의 사슬을 단락까지 잇는다
#     공식 발화요인 분류는 '반단선에 의한 단락'이라고 적는다. 압착손상·절연열화도
#     마찬가지로 '~에 의한 단락'이다. 즉 셋 다 단락으로 귀결되고, 변별은 그 단락을
#     부른 원인에서 나온다.
#
#     우리는 반단선을 저항 발열과 직렬 아크에서 끝내 두어 단락까지 가지 않았다.
#     문헌이 그 사이를 메운다 — 반단선부의 접촉저항으로 국부 발열이 일어나
#     피복이 절연 파괴되고 선간 단락에 이른다.
#
#       반복 굴곡·진동 → 소선 파단 → 접촉저항 발열 → 피복 절연파괴 → 선간 단락
#                                    (여기까지만 모형화돼 있었다)
#
#     이 사슬이 이어지면 단락흔이 세 가설 모두에서 나온다는 것이 구조로 설명된다.
#     사례 실측에서 단락흔의 변별력이 27% 에 그친 것과 일치한다.
# ============================================================================
efi:PartialDisconnectionInducedArc a owl:Class ; rdfs:subClassOf efi:ShortCircuitArc ;
    rdfs:label "반단선 유발 단락 아크"@ko ; skos:prefLabel "반단선 유발 단락 아크"@ko ;
    rdfs:comment "반단선부 접촉저항 발열이 피복을 절연 파괴해 이르는 선간 단락"@ko .
efi:PartialDisconnectionHeating efi:enablesProgressionTo efi:PartialDisconnectionInducedArc .
efi:enablesProgressionTo a owl:ObjectProperty ;
    rdfs:domain efi:HeatingMechanism ; rdfs:range efi:HeatingMechanism ;
    rdfs:label "다음 단계 발열로 진행함"@ko ; skos:prefLabel "다음 단계 발열로 진행함"@ko ;
    rdfs:comment "발화 경로가 여러 단계일 때 앞 단계가 뒤 단계를 부른다. 반단선이 그 예다"@ko .

efi:PartialDisconnectionScenario efi:hasDeclaredMechanism efi:PartialDisconnectionInducedArc .
efi:PartialDisconnectionInducedArc efi:producesDamage
    efi:ArcMeltMark , efi:ArcBead , efi:StrandFracture , efi:SmallMeltBallOnStrandEnd .
efi:PartialDisconnectionScenario efi:canManifest efi:ArcMeltMark .
efi:PartialDisconnectionInducedArc efi:ignites efi:InsulationMaterialFuel .


########################################################################
# 32. 국내 실무 감식 지식 — 소방청 화재조사실무Ⅳ (2025) 제2편 전기화재감식
#
# 출처 구분: 이 절은 NFPA 조항이 아니라 국내 실무 교재다. Table 2 와 같은 층이므로
# 지표 규칙에 조항을 붙이지 않는다. 클래스 주석에 쪽수를 남겨 추적만 한다.
#
# 왜 필요했나 — 지금까지 5대 요인의 '원인'은 채웠으나 요인을 가르는 '형태'는
# 단락흔·용융구 수준에 머물러 있었다. 실무 교재는 훨씬 구체적인 감별 기준을 갖고
# 있고, 그 기준들이 우리가 못 가르던 바로 그 쌍을 가른다.
########################################################################

# ── 32.1 퓨즈 용단 형태 (p.203)
# 한 관측이 네 갈래를 가른다. 이만큼 변별하는 형태는 지금까지 없었다.
efi:Fuse a owl:Class ; rdfs:subClassOf efi:ElectricalArtifact ; rdfs:label "퓨즈"@ko ; skos:prefLabel "퓨즈"@ko .
efi:FuseMeltPattern a owl:Class ; rdfs:subClassOf efi:DamagePattern ; rdfs:label "퓨즈 용단 형태"@ko ; skos:prefLabel "퓨즈 용단 형태"@ko .
efi:FuseGloballyMeltedScattered a owl:Class ; rdfs:subClassOf efi:FuseMeltPattern ; rdfs:label "퓨즈 전체 용융·비산"@ko ; skos:prefLabel "퓨즈 전체 용융·비산"@ko ; rdfs:comment "퓨즈 몸체 전체가 녹아 둥근 형태로 비산해 케이스에 부착 — 단락 (실무Ⅳ p.203)"@ko .
efi:FuseMeltedAtCenter a owl:Class ; rdfs:subClassOf efi:FuseMeltPattern ; rdfs:label "퓨즈 중앙부 용단"@ko ; skos:prefLabel "퓨즈 중앙부 용단"@ko ; rdfs:comment "100~300% 과부하 시 중앙부가 용단된다 (실무Ⅳ p.203)"@ko .
efi:FuseEndsDarkened a owl:Class ; rdfs:subClassOf efi:FuseMeltPattern ; rdfs:label "퓨즈 양단 흑변"@ko ; skos:prefLabel "퓨즈 양단 흑변"@ko ; rdfs:comment "접촉불량으로 용단되면 양쪽 끝이 검게 변색된다 (실무Ⅳ p.203)"@ko .
efi:FuseIrregularlyMelted a owl:Class ; rdfs:subClassOf efi:FuseMeltPattern ; rdfs:label "퓨즈 불규칙 용융"@ko ; skos:prefLabel "퓨즈 불규칙 용융"@ko ; rdfs:comment "외부 화염에 의한 용융은 불규칙한 형태다 (실무Ⅳ p.203)"@ko .
efi:Fuse efi:exhibits efi:FuseGloballyMeltedScattered , efi:FuseMeltedAtCenter , efi:FuseEndsDarkened , efi:FuseIrregularlyMelted .
efi:PoorContactHeating efi:producesDamage efi:FuseEndsDarkened .
efi:PoorContactScenario efi:canManifest efi:FuseEndsDarkened .
efi:OverloadHeating efi:producesDamage efi:FuseMeltedAtCenter .
efi:ShortCircuitArc efi:producesDamage efi:FuseGloballyMeltedScattered .
efi:ExternalFlameExposure efi:producesDamage efi:FuseIrregularlyMelted .
efi:ExternalFlameScenario efi:canManifest efi:FuseIrregularlyMelted .

# ── 32.2 반단선 용흔과 도체 절단 용흔의 위치 차이 (p.150)
# 반단선과 기계적 손상을 가르는 형태 기준. 우리가 가장 못 가르던 쌍이다.
efi:MeltMarkOnBothSidesOfBreak a owl:Class ; rdfs:subClassOf efi:MeltMark ; rdfs:label "단선부 양측 용흔"@ko ; skos:prefLabel "단선부 양측 용흔"@ko ; rdfs:comment "반단선은 단선 부분의 양쪽에 용흔이 생긴다 (실무Ⅳ p.150)"@ko .
efi:MeltMarkOnSupplySideOnly a owl:Class ; rdfs:subClassOf efi:MeltMark ; rdfs:label "전원측 편중 용흔"@ko ; skos:prefLabel "전원측 편중 용흔"@ko ; rdfs:comment "금속 등 도체로 절단된 경우 전원측 한쪽에 집중적으로 생긴다 (실무Ⅳ p.150)"@ko .
efi:StrandedConductor efi:exhibits efi:MeltMarkOnBothSidesOfBreak , efi:MeltMarkOnSupplySideOnly .
efi:PartialDisconnectionInducedArc efi:producesDamage efi:MeltMarkOnBothSidesOfBreak .
efi:PartialDisconnectionScenario efi:canManifest efi:MeltMarkOnBothSidesOfBreak .
efi:CrushInducedArc efi:producesDamage efi:MeltMarkOnSupplySideOnly .
efi:CrushDamageScenario efi:canManifest efi:MeltMarkOnSupplySideOnly .

# ── 32.3 반단선의 정량 정의 (p.149)
# "소선이 10% 이상 끊어졌거나 전체가 완전히 단선된 후 일부가 접촉상태로 남아 있는 상태".
# 우리는 StrandFracture 를 정도 구분 없이 써 왔다. 정의를 물화한다.
efi:StrandFractureOverTenPercent a owl:Class ; rdfs:subClassOf efi:StrandFracture ; rdfs:label "소선 10% 이상 단선"@ko ; skos:prefLabel "소선 10% 이상 단선"@ko ; rdfs:comment "국내 실무의 반단선 정의. 단선율 10%를 넘으면 이후 급격히 증가한다 (실무Ⅳ p.149). 통전 단면적 감소는 곧 과부하 상태를 뜻한다."@ko .
efi:PartialDisconnectionHeating efi:producesDamage efi:StrandFractureOverTenPercent .
efi:PartialDisconnectionScenario efi:canManifest efi:StrandFractureOverTenPercent .

# ── 32.4 트래킹의 필요조건 — 유기절연물 (p.147)
# "무기절연물은 도전성물질의 생성이 적어 트래킹 문제가 적지만, 유기절연물은 탄화하여
#  도전성물질(흑연)이 생기기 쉽다." 오염 환경만으로는 부족했다.
efi:OrganicInsulationPresent a owl:Class ; rdfs:subClassOf efi:InsulationCondition ; rdfs:label "유기 절연물 개재"@ko ; skos:prefLabel "유기 절연물 개재"@ko ; rdfs:comment "이극 도체 사이에 유기 절연물이 있어야 탄화 도전로가 생긴다. 무기 절연물에서는 트래킹이 성립하기 어렵다 (실무Ⅳ p.147)"@ko .
efi:OrganicInsulationPresent efi:enables efi:ArcTracking , efi:LeakageCurrentHeating .
efi:TrackingScenario rdfs:subClassOf [ a owl:Restriction ; owl:onProperty efi:hasAntecedent ; owl:someValuesFrom efi:OrganicInsulationPresent ] .

# ── 32.5 아산화동 적색 결정 (p.153)
# "출화부로 추정되는 접촉불량 개소에 아산화동이 없으면 접촉저항에 의한 발열이 원인."
# 곧 적색 결정의 유무가 접촉불량의 두 하위 경로를 가른다.
efi:RubyRedCrystal a owl:Class ; rdfs:subClassOf efi:CuprousOxideGrowth ; rdfs:label "아산화동 적색 결정"@ko ; skos:prefLabel "아산화동 적색 결정"@ko ; rdfs:comment "검은 덩어리를 회수해 20배로 확대하면 보이는 진홍색 유리형 결정. 아산화동 특유이며 출화개소에 대응하는 도체 접촉부에서 관찰된다 (실무Ⅳ p.153). 현미경이 없으면 저항이 0도 무한대도 아닐 때 가열해 저항이 내려가는지로 대신한다 — 아산화동은 부의 저항온도계수를 갖는다."@ko .
efi:ConnectionPoint efi:exhibits efi:RubyRedCrystal .
efi:PoorContactHeating efi:producesDamage efi:RubyRedCrystal .
efi:PoorContactScenario efi:canManifest efi:RubyRedCrystal .


# ── 32.6 지표 규칙 — 국내 실무 층이므로 조항을 붙이지 않는다
efi:R_PC_sup4  a efi:IndicatorRule ; efi:forScenario efi:PoorContactScenario ; efi:indicates efi:FuseEndsDarkened ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 10 .
efi:R_PC_sup5  a efi:IndicatorRule ; efi:forScenario efi:PoorContactScenario ; efi:indicates efi:RubyRedCrystal ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 10 .
efi:R_PD_sup5  a efi:IndicatorRule ; efi:forScenario efi:PartialDisconnectionScenario ; efi:indicates efi:MeltMarkOnBothSidesOfBreak ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 10 .
efi:R_PD_sup6  a efi:IndicatorRule ; efi:forScenario efi:PartialDisconnectionScenario ; efi:indicates efi:StrandFractureOverTenPercent ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 6 .
efi:R_CD_sup3  a efi:IndicatorRule ; efi:forScenario efi:CrushDamageScenario ; efi:indicates efi:MeltMarkOnSupplySideOnly ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 10 .
efi:R_TR_sup3  a efi:IndicatorRule ; efi:forScenario efi:TrackingScenario ; efi:indicates efi:OrganicInsulationPresent ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 15 .
efi:R_EF_sup2  a efi:IndicatorRule ; efi:forScenario efi:ExternalFlameScenario ; efi:indicates efi:FuseIrregularlyMelted ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 0 .

# 편향 점검 결과 반영 — 화재도 내는 양상은 외부화염에도 선언해야 한다.
# 소선 10% 이상 단선: 10% 라는 정도는 발화 전 상태를 뜻하지만, 소손 후 형태만으로는
# 그 파단이 발화 전인지 화재 중인지 가릴 수 없다. 상위 StrandFracture 와 같이 둔다.
efi:ExternalFlameExposure efi:producesDamage efi:StrandFractureOverTenPercent , efi:FuseGloballyMeltedScattered , efi:FuseMeltPattern .
efi:ExternalFlameScenario efi:canManifest efi:StrandFractureOverTenPercent , efi:FuseGloballyMeltedScattered , efi:FuseMeltPattern .

# 아산화동 증식발열은 접촉불량의 확립된 하위 경로다 (실무Ⅳ p.150~153).
# "접속기구의 체결 불량이나 조임장치의 느슨함으로 접촉이 불완전해지고 그 부분의
#  저항이 커져 국부과열이 발생할 때 특수산화물이 생성되어 아산화동 증식발열현상에
#  의해 화재의 원인이 된다." 클래스도 사슬도 이미 있었으나 쓰는 규칙이 없었다.
efi:R_PC_sup6  a efi:IndicatorRule ; efi:forScenario efi:PoorContactScenario ; efi:indicates efi:CuprousOxideGrowth ; efi:hasRole efi:Supporting ; efi:requiresStatus efi:Confirmed ; efi:scoreDelta 10 .
