kfc:Factor-Carelessness a skos:Concept ; skos:inScheme kfc:Factor ; skos:topConceptOf kfc:Factor ;
    skos:prefLabel "부주의"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.45" .
