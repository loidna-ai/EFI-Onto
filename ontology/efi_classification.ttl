# ── [K2] 발화열원 (heat source) — 대분류 9 · 소분류 26
#  매뉴얼 제1편 제2장 2.1 (p.21~32) 의 일곱 대분류 + 별지 4 의 기타·미상.
#  전기와 닿는 소분류는 작동기기 01·02·03 뿐이고 '전기적 저항 발열'은 없다 — 짝은 efi_tbox.ttl 48.6.
kfc:HeatSource a skos:ConceptScheme ;
    dcterms:isPartOf efi:KoreaFireReportClassification ;
    skos:prefLabel "발화열원 (국가화재분류체계)"@ko ;
    skos:definition "발화의 최초원인이 된 불꽃 또는 열. 최초 착화물에 화재를 발생시킨 불꽃 또는 열"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) 제1편 제2장 2.1 발화열원, p.21 분류체계도" .


kfc:HeatSource-OperatingEquipment a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:topConceptOf kfc:HeatSource ;
    skos:prefLabel "작동기기"@ko ;
    skos:definition "전기·전자기계 및 제품, 전기·석유난로, 차량엔진, 컨베이어 설비 등 작동하고 있는 기계나 기구 등으로부터 발생한 전기적 아크, 불꽃, 스파크 등이 화재발생의 발화열원인 경우"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.22" .
kfc:HeatSource skos:hasTopConcept kfc:HeatSource-OperatingEquipment .
kfc:HeatSource-OperatingEquipment-01 a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:broader kfc:HeatSource-OperatingEquipment ; skos:notation "1" ;
    skos:prefLabel "전기적 아크(단락)"@ko ;
    skos:definition "전선 및 전기기기의 절연체가 절연열화 또는 절연파괴 되면서 발생된 전기아크, 전기스파크로 인해 발화하는 경우. 사례에는 단락으로 발생된 주울열에 의한 발화도 든다"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.22" .
kfc:HeatSource-OperatingEquipment skos:narrower kfc:HeatSource-OperatingEquipment-01 .
kfc:HeatSource-OperatingEquipment-02 a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:broader kfc:HeatSource-OperatingEquipment ; skos:notation "2" ;
    skos:prefLabel "불꽃, 스파크, 정전기"@ko ;
    skos:definition "작동하고 있는 기계나 기구 등으로부터 발생한 불꽃, 스파크, 정전기가 가연물에 착화되어 발생되는 화재"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.22" .
kfc:HeatSource-OperatingEquipment skos:narrower kfc:HeatSource-OperatingEquipment-02 .
kfc:HeatSource-OperatingEquipment-03 a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:broader kfc:HeatSource-OperatingEquipment ; skos:notation "3" ;
    skos:prefLabel "기기 전도·복사열, 기기발열"@ko ;
    skos:definition "작동하고 있는 기계나 기구 등으로부터 발생한 발열과 열의 전도·복사에 의해 발생하는 화재"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.22" .
kfc:HeatSource-OperatingEquipment skos:narrower kfc:HeatSource-OperatingEquipment-03 .
kfc:HeatSource-OperatingEquipment-04 a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:broader kfc:HeatSource-OperatingEquipment ; skos:notation "4" ;
    skos:prefLabel "역화"@ko ;
    skos:definition "연소중인 불꽃이 거꾸로 흘러 가연성 유류 및 가스를 착화시켜 발생하는 화재"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.23" .
kfc:HeatSource-OperatingEquipment skos:narrower kfc:HeatSource-OperatingEquipment-04 .
kfc:HeatSource-OperatingEquipment-05 a skos:Concept ; skos:inScheme kfc:HeatSource ; skos:broader kfc:HeatSource-OperatingEquipment ; skos:notation "5" ;
    skos:prefLabel "기타"@ko ;
    dcterms:source "소방청 『국가화재분류체계 매뉴얼』(2019. 12.) p.23" .
